diff --git a/cvt_data_format_jsonl2json.sh b/cvt_data_format_jsonl2json.sh
new file mode 100755
index 0000000000000000000000000000000000000000..91550575c717f22cc5c3cae95e2709a699fe1b5d
--- /dev/null
+++ b/cvt_data_format_jsonl2json.sh
@@ -0,0 +1,195 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+
+# Default data paths. They can be overridden by passing either:
+#   bash cvt_data_format_jsonl2json.sh <jsonl_path> <json_path>
+# or, for recursive batch conversion (quote the glob patterns):
+#   bash cvt_data_format_jsonl2json.sh \
+#     'data/xxx/jsonl/**/*.jsonl' \
+#     'data/xxx/json/**/*.json'
+#
+# In batch mode, the directory hierarchy below the non-glob input root is
+# preserved below the non-glob output root. The output argument can also be a
+# directory such as 'data/qa/0730/json'.
+# Supported JSONL records use either instruction/input/output or prompt/response.
+
+JSONL_DATA_PATH="${1:-${JSONL_DATA_PATH}}"
+JSON_DATA_PATH="${2:-${JSON_DATA_PATH}}"
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+python3 - "${SCRIPT_DIR}" "${JSONL_DATA_PATH}" "${JSON_DATA_PATH}" <<'PY'
+import glob
+import json
+import sys
+from pathlib import Path
+
+
+def resolve_path(root_dir, raw_path):
+    path = Path(raw_path)
+    if path.is_absolute():
+        return path
+    return Path(root_dir) / path
+
+
+def glob_root(pattern):
+    """Return the static path prefix before the first glob component."""
+    static_parts = []
+    for part in pattern.parts:
+        if glob.has_magic(part):
+            break
+        static_parts.append(part)
+
+    if not static_parts:
+        return Path(".")
+    return Path(*static_parts)
+
+
+def to_text(value):
+    if value is None:
+        return ""
+    if isinstance(value, str):
+        return value
+    return str(value)
+
+
+def build_user_content(record):
+    instruction = to_text(record.get("instruction"))
+    input_content = to_text(record["input"])
+    if instruction.strip():
+        if input_content:
+            return instruction + "\n" + input_content
+        return instruction
+    return input_content
+
+
+def build_message_contents(record, jsonl_path, line_no):
+    """Return user and assistant text for either supported JSONL schema."""
+    has_prompt = "prompt" in record
+    has_response = "response" in record
+    if has_prompt or has_response:
+        for required_key in ("prompt", "response"):
+            if required_key not in record:
+                raise ValueError(
+                    f"{jsonl_path}:{line_no}: missing required key "
+                    f"'{required_key}' for prompt-response format"
+                )
+        return to_text(record["prompt"]), to_text(record["response"])
+
+    for required_key in ("input", "output"):
+        if required_key not in record:
+            raise ValueError(f"{jsonl_path}:{line_no}: missing required key '{required_key}'")
+    return build_user_content(record), to_text(record["output"])
+
+
+def convert_jsonl_to_json(jsonl_path, json_path):
+    converted = []
+    with jsonl_path.open("r", encoding="utf-8") as fin:
+        for line_no, line in enumerate(fin, start=1):
+            stripped = line.strip()
+            if not stripped:
+                continue
+
+            try:
+                record = json.loads(stripped)
+            except json.JSONDecodeError as exc:
+                raise ValueError(f"{jsonl_path}:{line_no}: invalid JSONL record: {exc}") from exc
+
+            if not isinstance(record, dict):
+                raise ValueError(f"{jsonl_path}:{line_no}: JSONL record must be an object")
+            user_content, assistant_content = build_message_contents(record, jsonl_path, line_no)
+
+            converted.append(
+                {
+                    "messages": [
+                        {
+                            "content": user_content,
+                            "role": "user",
+                        },
+                        {
+                            "content": assistant_content,
+                            "role": "assistant",
+                        },
+                    ],
+                    "images": [],
+                }
+            )
+
+    json_path.parent.mkdir(parents=True, exist_ok=True)
+    with json_path.open("w", encoding="utf-8") as fout:
+        json.dump(converted, fout, ensure_ascii=False, indent=2)
+        fout.write("\n")
+
+    return len(converted)
+
+
+def convert_matching_jsonl_files(input_pattern, output_pattern):
+    input_root = glob_root(input_pattern)
+    if not input_root.is_dir():
+        raise NotADirectoryError(f"Input glob root is not a directory: {input_root}")
+
+    if glob.has_magic(str(output_pattern)):
+        output_root = glob_root(output_pattern)
+        if output_pattern.suffix.lower() != ".json":
+            raise ValueError(
+                "Output glob must describe JSON files, for example "
+                "'data/qa/0730/json/**/*.json'"
+            )
+    else:
+        output_root = output_pattern
+        if output_root.exists() and not output_root.is_dir():
+            raise NotADirectoryError(
+                f"Batch output path must be a directory or glob pattern: {output_root}"
+            )
+
+    matched_paths = sorted(
+        {
+            Path(matched_path)
+            for matched_path in glob.iglob(str(input_pattern), recursive=True)
+            if Path(matched_path).is_file()
+            and Path(matched_path).suffix.lower() == ".jsonl"
+        }
+    )
+    if not matched_paths:
+        raise FileNotFoundError(f"No JSONL files matched input pattern: {input_pattern}")
+
+    total_records = 0
+    for jsonl_path in matched_paths:
+        relative_path = jsonl_path.relative_to(input_root)
+        json_path = (output_root / relative_path).with_suffix(".json")
+        count = convert_jsonl_to_json(jsonl_path, json_path)
+        total_records += count
+        print(f"Converted {count} records: {jsonl_path} -> {json_path}")
+
+    print(
+        f"Converted {len(matched_paths)} files and {total_records} records "
+        f"into: {output_root}"
+    )
+
+
+def main():
+    if len(sys.argv) != 4:
+        raise SystemExit(
+            "Usage: cvt_data_format_jsonl2json.sh "
+            "<jsonl_path_or_glob> <json_path_or_glob>"
+        )
+
+    root_dir, jsonl_raw_path, json_raw_path = sys.argv[1:]
+    jsonl_path = resolve_path(root_dir, jsonl_raw_path)
+    json_path = resolve_path(root_dir, json_raw_path)
+
+    if glob.has_magic(str(jsonl_path)):
+        convert_matching_jsonl_files(jsonl_path, json_path)
+        return
+
+    if not jsonl_path.is_file():
+        raise FileNotFoundError(f"JSONL file not found: {jsonl_path}")
+
+    count = convert_jsonl_to_json(jsonl_path, json_path)
+    print(f"Converted {count} records: {jsonl_path} -> {json_path}")
+
+
+if __name__ == "__main__":
+    main()
+PY
