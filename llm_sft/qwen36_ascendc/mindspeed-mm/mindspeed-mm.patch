--- /dev/null
+++ b/tests/ut_fsdp/test_qwen2vl_dataset.py
@@ -0,0 +1,156 @@
+from contextlib import nullcontext
+
+import pytest
+
+from mindspeed_mm.fsdp.data.data_utils.func_utils.convert import DataArguments
+from mindspeed_mm.fsdp.data.datasets.huggingface import qwen2vl_dataset
+from mindspeed_mm.fsdp.data.datasets.huggingface.qwen2vl_dataset import _maybe_shuffle_before_packing
+
+
+class _ShuffleSpyDataset:
+    def __init__(self):
+        self.calls = []
+        self.shuffled = object()
+
+    def shuffle(self, **kwargs):
+        self.calls.append(kwargs)
+        return self.shuffled
+
+
+def test_shuffle_before_packing_defaults_preserve_existing_behavior():
+    data_args = DataArguments()
+
+    assert data_args.shuffle_before_packing is False
+    assert data_args.shuffle_before_packing_seed == 42
+
+    dataset = _ShuffleSpyDataset()
+    assert _maybe_shuffle_before_packing(dataset, data_args) is dataset
+    assert dataset.calls == []
+
+
+def test_shuffle_before_packing_uses_configured_seed_and_cache_policy():
+    data_args = DataArguments(
+        packing=True,
+        shuffle_before_packing=True,
+        shuffle_before_packing_seed=1234,
+    )
+    dataset = _ShuffleSpyDataset()
+
+    result = _maybe_shuffle_before_packing(dataset, data_args, load_from_cache_file=False)
+
+    assert result is dataset.shuffled
+    assert dataset.calls == [{"seed": 1234, "load_from_cache_file": False}]
+
+
+@pytest.mark.parametrize(
+    ("stage", "packing"),
+    [
+        ("sft", False),
+        ("pretrain", True),
+        ("rm", True),
+    ],
+)
+def test_shuffle_before_packing_only_applies_to_sft_packing(stage, packing):
+    data_args = DataArguments(
+        stage=stage,
+        packing=packing,
+        shuffle_before_packing=True,
+    )
+    dataset = _ShuffleSpyDataset()
+
+    assert _maybe_shuffle_before_packing(dataset, data_args) is dataset
+    assert dataset.calls == []
+
+
+def test_shuffle_before_packing_rejects_streaming_dataset():
+    data_args = DataArguments(
+        packing=True,
+        streaming=True,
+        shuffle_before_packing=True,
+    )
+
+    with pytest.raises(ValueError, match="requires a non-streaming dataset"):
+        _maybe_shuffle_before_packing(_ShuffleSpyDataset(), data_args)
+
+
+def test_shuffle_before_packing_rejects_on_the_fly_preprocessing():
+    data_args = DataArguments(
+        packing=True,
+        preprocess_on_fly=True,
+        shuffle_before_packing=True,
+    )
+
+    with pytest.raises(ValueError, match="requires offline preprocessing"):
+        _maybe_shuffle_before_packing(_ShuffleSpyDataset(), data_args)
+
+
+def test_dataset_is_aligned_then_shuffled_before_packing_map(monkeypatch):
+    events = []
+
+    class _Dataset:
+        def __init__(self, name):
+            self.name = name
+
+        def __iter__(self):
+            yield {"_prompt": []}
+
+        def shuffle(self, **kwargs):
+            events.append(("shuffle", self.name, kwargs["seed"]))
+            return shuffled_dataset
+
+        def map(self, *args, **kwargs):
+            events.append(("map", self.name))
+            return self
+
+    class _TrainingArguments:
+        def __init__(self, **kwargs):
+            pass
+
+        def main_process_first(self, **kwargs):
+            return nullcontext()
+
+    raw_dataset = _Dataset("raw")
+    aligned_dataset = _Dataset("aligned")
+    shuffled_dataset = _Dataset("shuffled")
+
+    monkeypatch.setattr(qwen2vl_dataset, "TrainingArguments", _TrainingArguments)
+    monkeypatch.setattr(qwen2vl_dataset, "load_dataset", lambda **kwargs: raw_dataset)
+    monkeypatch.setattr(
+        qwen2vl_dataset,
+        "load_tokenizer",
+        lambda process_args: {"tokenizer": object(), "processor": None},
+    )
+    monkeypatch.setattr(
+        qwen2vl_dataset,
+        "get_template_and_fix_tokenizer",
+        lambda tokenizer, template: object(),
+    )
+
+    def _align(dataset, dataset_attr, data_args):
+        events.append(("align", dataset.name))
+        return aligned_dataset
+
+    monkeypatch.setattr(qwen2vl_dataset, "align_dataset", _align)
+    monkeypatch.setattr(qwen2vl_dataset.torch.distributed, "is_initialized", lambda: False)
+
+    import multiprocess
+
+    monkeypatch.setattr(multiprocess, "get_start_method", lambda allow_none=True: "spawn")
+
+    result = qwen2vl_dataset.get_qwen2vl_dataset(
+        basic_param={
+            "dataset": "dummy.json",
+            "packing": True,
+            "shuffle_before_packing": True,
+            "shuffle_before_packing_seed": 137,
+        },
+        preprocess_param={},
+        dataset_param={"attr": {}},
+    )
+
+    assert result is shuffled_dataset
+    assert events == [
+        ("align", "raw"),
+        ("shuffle", "aligned", 137),
+        ("map", "shuffled"),
+    ]
