+    if save_interval_epochs == 0:
+        return train_iters, []
+
+    save_iterations = [
+        _iteration_at_epoch(epoch)
+        for epoch in range(save_interval_epochs, train_epochs + 1, save_interval_epochs)
+    ]
+    return train_iters, save_iterations
