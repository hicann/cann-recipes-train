@@ -0,0 +1,84 @@
+from types import SimpleNamespace
+
+import torch.nn as nn
+
+import mindspeed_mm.fsdp.train.trainer as trainer_module
+from mindspeed_mm.fsdp.train.trainer import Trainer
+
+
+class _FeaturesApplier:
+    def pre_fully_shard_apply(self, model):
+        return model
+
+    def post_fully_shard_apply(self, model):
+        return model
+
+
+class _LoraWeightManager:
+    def __init__(self, model):
+        self.model = model
+
+    def verify_lora_weights(self):
+        return True
+
+
+def _trainer(load):
+    instance = object.__new__(Trainer)
+    instance.args = SimpleNamespace(
+        parallel=SimpleNamespace(
+            fsdp_plan=SimpleNamespace(cpu_offload=False),
+        ),
+        training=SimpleNamespace(
+            init_model_with_meta_device=True,
+            load=load,
+            load_rank0_and_broadcast=False,
+            lora=SimpleNamespace(
+                enable=True,
+                init_lora_weights=True,
+            ),
+        ),
+    )
+    model = nn.Linear(2, 2)
+    instance.get_foundation_model = lambda: model
+    instance.enable_lora = lambda current_model: current_model
+    instance.model_features_applier = _FeaturesApplier()
+    instance.model_parallel_applier = lambda current_model: current_model
+    return instance
+
+
+def _patch_initializers(monkeypatch, calls):
+    monkeypatch.setattr(trainer_module, "get_device_type", lambda: "cpu")
+    monkeypatch.setattr(
+        trainer_module,
+        "to_empty_if_needed",
+        lambda model, device: calls.append("materialize"),
+    )
+    monkeypatch.setattr(
+        trainer_module,
+        "init_model_weights",
+        lambda model: calls.append("base_init"),
+    )
+    monkeypatch.setattr(
+        trainer_module,
+        "initialize_lora_weights_after_materialization",
+        lambda model, method: calls.append(("lora_init", method)),
+    )
+    monkeypatch.setattr(trainer_module, "LoraWeightManager", _LoraWeightManager)
+
+
+def test_meta_lora_with_checkpoint_reinitializes_adapters_last(monkeypatch):
+    calls = []
+    _patch_initializers(monkeypatch, calls)
+
+    _trainer(load="/checkpoint").get_model()
+
+    assert calls == ["materialize", "base_init", ("lora_init", True)]
+
+
+def test_meta_lora_without_checkpoint_reinitializes_adapters_last(monkeypatch):
+    calls = []
+    _patch_initializers(monkeypatch, calls)
+
+    _trainer(load=None).get_model()
+
+    assert calls == ["materialize", "base_init", ("lora_init", True)]
