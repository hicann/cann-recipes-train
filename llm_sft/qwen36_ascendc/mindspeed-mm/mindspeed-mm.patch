+@torch.no_grad()
+def initialize_lora_weights_after_materialization(
+    model: nn.Module,
+    init_lora_weights: bool | str,
+) -> int:
+    """Initialize LoRA weights after a meta-initialized model is materialized.
+
+    PEFT initializes adapters when they are injected. If the base model lives on
+    the meta device at that point, those writes do not initialize real storage.
+    ``Module.to_empty`` later allocates that storage without preserving values,
+    so adapters must be initialized again after materialization.
+
+    Args:
+        model: Materialized model containing PEFT LoRA layers.
+        init_lora_weights: The PEFT LoRA initialization method.
+
+    Returns:
+        Number of LoRA adapters initialized.
+
+    Raises:
+        ImportError: If PEFT is not installed.
+        ValueError: If the requested initialization needs materialized base
+            weights and therefore cannot run before the base checkpoint load.
+        RuntimeError: If no LoRA adapters are found.
+    """
+    try:
+        from peft.tuners.lora.layer import LoraLayer
+    except ImportError as e:
+        raise ImportError(
+            "PEFT library is required for LoRA training. "
+            "Please install it with: pip install peft"
+        ) from e
+
+    if isinstance(init_lora_weights, str):
+        init_method = init_lora_weights.lower()
+        if init_method != "gaussian":
+            raise ValueError(
+                "Meta-device LoRA initialization currently supports "
+                "init_lora_weights=True, False, or 'gaussian'. "
+                f"Method '{init_lora_weights}' requires materialized base weights."
+            )
+
+    initialized_adapters = 0
+    for module in model.modules():
+        if not isinstance(module, LoraLayer):
+            continue
+
+        linear_adapters = set(getattr(module, "lora_A", {}).keys())
+        embedding_adapters = set(getattr(module, "lora_embedding_A", {}).keys())
+        adapter_names = linear_adapters | embedding_adapters
+
+        for adapter_name in adapter_names:
+            if init_lora_weights is False:
+                # PEFT leaves the default torch initialization in place when
+                # init_lora_weights=False. Recreate it because to_empty() does
+                # not preserve the initialization performed on meta tensors.
+                if adapter_name in linear_adapters:
+                    module.lora_A[adapter_name].reset_parameters()
+                    module.lora_B[adapter_name].reset_parameters()
+                if adapter_name in embedding_adapters:
+                    nn.init.normal_(module.lora_embedding_A[adapter_name])
+                    nn.init.normal_(module.lora_embedding_B[adapter_name])
+            else:
+                # PEFT semantics: True initializes A with Kaiming uniform and
+                # B with zeros; "gaussian" initializes A normally and B with
+                # zeros. DTensor dispatch applies these operations per shard.
+                module.reset_lora_parameters(adapter_name, init_lora_weights)
+
+            initialized_adapters += 1
+
+    if initialized_adapters == 0:
+        raise RuntimeError("No LoRA adapters found after model materialization")
+
+    logger.info(
+        "Initialized %d LoRA adapter(s) after meta-device materialization",
+        initialized_adapters,
+    )
+    return initialized_adapters
+
