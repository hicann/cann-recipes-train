+class TestInitializeLoraWeightsAfterMaterialization:
+    """Test LoRA initialization after meta storage is materialized."""
+
+    @staticmethod
+    def _lora_model(init_lora_weights=True, *, meta=False):
+        pytest.importorskip("peft", exc_type=ImportError)
+        if meta:
+            with torch.device("meta"):
+                model = SimpleModel()
+        else:
+            model = SimpleModel()
+        model = add_lora_to_model(
+            model=model,
+            lora_rank=4,
+            lora_alpha=8,
+            lora_target_modules=["linear1"],
+            lora_dropout=0.0,
+            init_lora_weights=init_lora_weights,
+        )
+        if meta:
+            model.to_empty(device="cpu")
+        return model
+
+    def test_default_initialization_keeps_lora_delta_zero(self) -> None:
+        model = self._lora_model(init_lora_weights=True, meta=True)
+        with torch.no_grad():
+            for name, param in model.named_parameters():
+                if "lora_" in name:
+                    param.fill_(7.0)
+
+        initialized = initialize_lora_weights_after_materialization(model, True)
+
+        lora_a = [param for name, param in model.named_parameters() if "lora_A" in name]
+        lora_b = [param for name, param in model.named_parameters() if "lora_B" in name]
+        assert initialized == 1
+        assert lora_a and all(torch.count_nonzero(param).item() > 0 for param in lora_a)
+        assert lora_b and all(torch.count_nonzero(param).item() == 0 for param in lora_b)
+
+    def test_false_recreates_torch_linear_defaults(self) -> None:
+        model = self._lora_model(init_lora_weights=False, meta=True)
+        with torch.no_grad():
+            for name, param in model.named_parameters():
+                if "lora_" in name:
+                    param.zero_()
+
+        initialize_lora_weights_after_materialization(model, False)
+
+        lora_a = [param for name, param in model.named_parameters() if "lora_A" in name]
+        lora_b = [param for name, param in model.named_parameters() if "lora_B" in name]
+        assert all(torch.count_nonzero(param).item() > 0 for param in lora_a)
+        assert all(torch.count_nonzero(param).item() > 0 for param in lora_b)
+
+    def test_data_dependent_initialization_is_rejected(self) -> None:
+        model = self._lora_model(init_lora_weights=True)
+
+        with pytest.raises(ValueError, match="requires materialized base weights"):
+            initialize_lora_weights_after_materialization(model, "pissa")
+
+
