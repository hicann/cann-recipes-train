new file mode 100644
index 00000000..fec969a9
--- /dev/null
+++ b/cvt_ckpt_dcp2hf_batch.sh
@@ -0,0 +1,197 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Convert all numeric iter_* checkpoints, or merge LoRA adapter checkpoints:
+#   bash cvt_ckpt_dcp2hf_batch.sh <checkpoint_dir> <save_hf_dir> [config]
+# Use LORA_MERGE_DEVICE=cpu to merge LoRA adapters on CPU instead of NPU.
+# Use CHECKPOINT_POSTPROCESS_DRY_RUN=1 to preview discovered artifacts and outputs.
+
+config=""
+if [ "$#" -eq 2 ] || [ "$#" -eq 3 ]; then
+  dcp_dir="$1"
+  save_hf_dir="$2"
+  if [ "$#" -eq 3 ]; then
+    config="$3"
+  fi
+else
+  echo "Usage: bash $0 <checkpoint_dir> <save_hf_dir> [config]" >&2
+  exit 2
+fi
+
+dcp_dir="${dcp_dir%/}"
+save_hf_dir="${save_hf_dir%/}"
+latest_file="${dcp_dir}/latest_checkpointed_iteration.txt"
+script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+single_convert_script="${script_dir}/cvt_ckpt_dcp2hf.sh"
+lora_merge_script="${script_dir}/checkpoint/common/merge_lora_safetensors_to_base.py"
+lora_merge_device="${LORA_MERGE_DEVICE:-npu}"
+postprocess_dry_run="${CHECKPOINT_POSTPROCESS_DRY_RUN:-0}"
+
+if [ ! -d "${dcp_dir}" ]; then
+  echo "Checkpoint dir does not exist: ${dcp_dir}"
+  exit 1
+fi
+if [ "${postprocess_dry_run}" != "0" ] && [ "${postprocess_dry_run}" != "1" ]; then
+  echo "CHECKPOINT_POSTPROCESS_DRY_RUN must be '0' or '1', got: ${postprocess_dry_run}"
+  exit 1
+fi
+
+latest_backup=""
+latest_existed=0
+
+restore_latest() {
+  if [ -z "${latest_backup}" ]; then
+    return
+  fi
+  if [ "${latest_existed}" -eq 1 ]; then
+    cp "${latest_backup}" "${latest_file}"
+  else
+    rm -f "${latest_file}"
+  fi
+  rm -f "${latest_backup}"
+}
+
+shopt -s nullglob
+iter_dirs=("${dcp_dir}"/iter_[0-9]*)
+lora_adapter_files=("${dcp_dir}"/lora_adapter_iteration_*.safetensors)
+
+if [ "${#iter_dirs[@]}" -eq 0 ] && [ "${#lora_adapter_files[@]}" -eq 0 ]; then
+  echo "No iter_* directories or LoRA adapter files found under: ${dcp_dir}"
+  exit 1
+fi
+
+dcp_converted_count=0
+if [ "${#iter_dirs[@]}" -gt 0 ] && [ ! -f "${single_convert_script}" ]; then
+  echo "Single convert script does not exist: ${single_convert_script}"
+  exit 1
+fi
+if [ "${#iter_dirs[@]}" -gt 0 ] && [ "${postprocess_dry_run}" -eq 0 ]; then
+  latest_backup="$(mktemp)"
+  if [ -f "${latest_file}" ]; then
+    cp "${latest_file}" "${latest_backup}"
+    latest_existed=1
+  fi
+  trap restore_latest EXIT
+fi
+
+for iter_dir in "${iter_dirs[@]}"; do
+  if [ ! -d "${iter_dir}" ]; then
+    continue
+  fi
+
+  iter_name="$(basename "${iter_dir}")"
+  iter_value="${iter_name#iter_}"
+  if [[ ! "${iter_value}" =~ ^[0-9]+$ ]]; then
+    echo "Skip non-numeric iter dir: ${iter_dir}"
+    continue
+  fi
+
+  iter_number="$(printf "%s" "${iter_value}" | sed 's/^0*//')"
+  if [ -z "${iter_number}" ]; then
+    iter_number=0
+  fi
+
+  save_hf_iter_dir="${save_hf_dir}_${iter_name}"
+  echo "Converting ${iter_dir} -> ${save_hf_iter_dir}"
+  if [ "${postprocess_dry_run}" -eq 0 ]; then
+    printf "%s\n" "${iter_number}" > "${latest_file}"
+    bash "${single_convert_script}" "${save_hf_iter_dir}" "${iter_dir}"
+  fi
+  dcp_converted_count=$((dcp_converted_count + 1))
+done
+
+lora_merged_count=0
+if [ "${#lora_adapter_files[@]}" -gt 0 ]; then
+  if [ -z "${config}" ]; then
+    echo "A config file is required to merge LoRA adapters under: ${dcp_dir}"
+    exit 1
+  fi
+  if [ ! -f "${config}" ]; then
+    echo "Config file does not exist: ${config}"
+    exit 1
+  fi
+  if [ ! -f "${lora_merge_script}" ]; then
+    echo "LoRA merge script does not exist: ${lora_merge_script}"
+    exit 1
+  fi
+  if [ "${lora_merge_device}" != "cpu" ] && [ "${lora_merge_device}" != "npu" ]; then
+    echo "LORA_MERGE_DEVICE must be 'cpu' or 'npu', got: ${lora_merge_device}"
+    exit 1
+  fi
+
+  lora_config_output="$(
+    python -c '
+import sys
+import yaml
+
+with open(sys.argv[1], encoding="utf-8") as config_file:
+    config = yaml.safe_load(config_file) or {}
+
+base_hf_dir = config.get("model", {}).get("model_name_or_path")
+lora_config = config.get("training", {}).get("lora", {})
+lora_alpha = lora_config.get("alpha")
+lora_rank = lora_config.get("rank")
+
+if not isinstance(base_hf_dir, str) or not base_hf_dir.strip():
+    raise SystemExit(f"model.model_name_or_path is missing or empty in config: {sys.argv[1]}")
+if not isinstance(lora_alpha, int) or isinstance(lora_alpha, bool) or lora_alpha <= 0:
+    raise SystemExit(f"training.lora.alpha must be a positive integer in config: {sys.argv[1]}")
+if not isinstance(lora_rank, int) or isinstance(lora_rank, bool) or lora_rank <= 0:
+    raise SystemExit(f"training.lora.rank must be a positive integer in config: {sys.argv[1]}")
+
+print(base_hf_dir)
+print(lora_alpha)
+print(lora_rank)
+' "${config}"
+  )"
+  mapfile -t lora_config_values <<< "${lora_config_output}"
+  if [ "${#lora_config_values[@]}" -ne 3 ]; then
+    echo "Failed to parse base HF directory and LoRA parameters from: ${config}"
+    exit 1
+  fi
+
+  base_hf_dir="${lora_config_values[0]}"
+  lora_alpha="${lora_config_values[1]}"
+  lora_rank="${lora_config_values[2]}"
+
+  if [ ! -d "${base_hf_dir}" ]; then
+    echo "Base HF directory from config does not exist: ${base_hf_dir}"
+    exit 1
+  fi
+
+  for lora_adapter_file in "${lora_adapter_files[@]}"; do
+    lora_adapter_name="$(basename "${lora_adapter_file}")"
+    iteration_value="${lora_adapter_name#lora_adapter_iteration_}"
+    iteration_value="${iteration_value%.safetensors}"
+    if [[ ! "${iteration_value}" =~ ^[0-9]+$ ]]; then
+      echo "Skip LoRA adapter with non-numeric iteration: ${lora_adapter_file}"
+      continue
+    fi
+
+    iteration_number="$(printf "%s" "${iteration_value}" | sed 's/^0*//')"
+    if [ -z "${iteration_number}" ]; then
+      iteration_number=0
+    fi
+
+    save_merged_hf_dir="${dcp_dir}-merged-hf-iter-${iteration_number}"
+    echo "Merging ${lora_adapter_file} with ${base_hf_dir} -> ${save_merged_hf_dir}"
+    if [ "${postprocess_dry_run}" -eq 0 ]; then
+      python "${lora_merge_script}" \
+        --base_hf_dir "${base_hf_dir}" \
+        --lora_safetensors "${lora_adapter_file}" \
+        --save_merged_hf_dir "${save_merged_hf_dir}" \
+        --lora_alpha "${lora_alpha}" \
+        --lora_r "${lora_rank}" \
+        --device "${lora_merge_device}"
+    fi
+    lora_merged_count=$((lora_merged_count + 1))
+  done
+fi
+
+if [ "${dcp_converted_count}" -eq 0 ] && [ "${lora_merged_count}" -eq 0 ]; then
+  echo "No valid checkpoints processed under: ${dcp_dir}"
+  exit 1
+fi
+
+echo "Converted ${dcp_converted_count} DCP checkpoint(s)."
+echo "Merged ${lora_merged_count} LoRA adapter checkpoint(s)."
