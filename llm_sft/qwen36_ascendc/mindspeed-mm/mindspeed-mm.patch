index 0000000000000000000000000000000000000000..dea67719f89352684ee86f08606feeeefb2dc05f
--- /dev/null
+++ b/tests/ut_fsdp/test_epoch_training.py
@@ -0,0 +1,179 @@
+"""Tests for epoch-based FSDP2 training and checkpoint scheduling."""
+
+import importlib.util
+from pathlib import Path
+import sys
+import types
+
+import pytest
+
+
+MODULE_PATH = (
+    Path(__file__).resolve().parents[2]
+    / "mindspeed_mm"
+    / "fsdp"
+    / "train"
+    / "epoch_schedule.py"
+)
+SPEC = importlib.util.spec_from_file_location("epoch_schedule", MODULE_PATH)
+epoch_schedule = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(epoch_schedule)
+
+
+def _load_module(monkeypatch, module_name, module_path):
+    spec = importlib.util.spec_from_file_location(module_name, module_path)
+    module = importlib.util.module_from_spec(spec)
+    monkeypatch.setitem(sys.modules, module_name, module)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_train_epoches_typo_points_to_train_epochs(monkeypatch):
+    """Validate the typo without importing the full Torch/NPU training stack."""
+    for package_name in (
+        "mindspeed_mm",
+        "mindspeed_mm.config",
+        "mindspeed_mm.config.arguments",
+        "mindspeed_mm.fsdp",
+        "mindspeed_mm.fsdp.params",
+    ):
+        package = types.ModuleType(package_name)
+        package.__path__ = []
+        monkeypatch.setitem(sys.modules, package_name, package)
+
+    repo_root = Path(__file__).resolve().parents[2]
+    _load_module(
+        monkeypatch,
+        "mindspeed_mm.config.arguments.base_args",
+        repo_root / "mindspeed_mm/config/arguments/base_args.py",
+    )
+    _load_module(
+        monkeypatch,
+        "mindspeed_mm.fsdp.params.lora_args",
+        repo_root / "mindspeed_mm/fsdp/params/lora_args.py",
+    )
+    training_args = _load_module(
+        monkeypatch,
+        "mindspeed_mm.fsdp.params.training_args",
+        repo_root / "mindspeed_mm/fsdp/params/training_args.py",
+    )
+    monkeypatch.setenv("LOCAL_RANK", "0")
+    monkeypatch.setenv("RANK", "0")
+    monkeypatch.setenv("WORLD_SIZE", "1")
+
+    with pytest.raises(ValueError, match=r"train_epoches.*train_epochs"):
+        training_args.TrainingArguments(train_epoches=3)
+
+
+class _StandardDataLoader:
+    batch_sampler = None
+
+    def __len__(self):
+        return 7
+
+
+class _BaseRandomLikeSampler:
+    total_samples = 17
+    last_batch_size = 1
+    micro_batch_times_data_parallel_size = 4
+
+
+class _BaseRandomDataLoader:
+    batch_sampler = _BaseRandomLikeSampler()
+
+    def __len__(self):
+        return 17
+
+
+def test_standard_dataloader_length_is_already_micro_batches():
+    assert epoch_schedule.get_epoch_micro_batches(_StandardDataLoader()) == (7, None)
+
+
+def test_base_random_sampler_length_is_normalized_and_dropped_tail_excluded():
+    assert epoch_schedule.get_epoch_micro_batches(_BaseRandomDataLoader()) == (4, 16)
+
+
+def test_epoch_mode_resolves_total_and_checkpoint_iterations():
+    train_iters, save_iterations = epoch_schedule.resolve_epoch_schedule(
+        micro_batches_per_epoch=10,
+        gradient_accumulation_steps=1,
+        train_epochs=3,
+        save_interval_epochs=2,
+    )
+
+    assert train_iters == 30
+    assert save_iterations == [20]
+
+
+def test_epoch_boundaries_do_not_drift_for_non_divisible_dataset():
+    train_iters, save_iterations = epoch_schedule.resolve_epoch_schedule(
+        micro_batches_per_epoch=85,
+        gradient_accumulation_steps=8,
+        train_epochs=5,
+        save_interval_epochs=1,
+    )
+
+    assert train_iters == 54
+    assert save_iterations == [11, 22, 32, 43, 54]
+
+
+def test_large_non_divisible_dataset_schedule():
+    train_iters, save_iterations = epoch_schedule.resolve_epoch_schedule(
+        micro_batches_per_epoch=1951,
+        gradient_accumulation_steps=8,
+        train_epochs=4,
+        save_interval_epochs=1,
+    )
+
+    assert train_iters == 976
+    assert save_iterations == [244, 488, 732, 976]
+
+
+def test_zero_save_interval_disables_periodic_epoch_saves():
+    train_iters, save_iterations = epoch_schedule.resolve_epoch_schedule(
+        micro_batches_per_epoch=10,
+        gradient_accumulation_steps=1,
+        train_epochs=3,
+        save_interval_epochs=0,
+    )
+
+    assert train_iters == 30
+    assert save_iterations == []
+
+
+@pytest.mark.parametrize(
+    "kwargs,error",
+    [
+        ({"train_epochs": 0}, "train_epochs must be a positive integer"),
+        ({"train_epochs": -1}, "train_epochs must be a positive integer"),
+        ({"save_interval_epochs": -1}, "save_interval must be >= 0"),
+        ({"micro_batches_per_epoch": 0}, "micro_batches_per_epoch must be a positive integer"),
+        ({"gradient_accumulation_steps": 0}, "gradient_accumulation_steps must be a positive integer"),
+        ({"micro_batches_per_epoch": 7}, "smaller than gradient_accumulation_steps"),
+    ],
+)
+def test_invalid_epoch_settings_are_rejected(kwargs, error):
+    settings = {
+        "micro_batches_per_epoch": 10,
+        "gradient_accumulation_steps": 8,
+        "train_epochs": 3,
+        "save_interval_epochs": 1,
+    }
+    settings.update(kwargs)
+
+    with pytest.raises(ValueError, match=error):
+        epoch_schedule.resolve_epoch_schedule(**settings)
+
+
+def test_checkpoint_due_uses_resolved_epoch_schedule():
+    save_iterations = {11, 22, 32, 43, 54}
+
+    assert not epoch_schedule.checkpoint_is_due(10, 1, save_iterations)
+    assert epoch_schedule.checkpoint_is_due(11, 1, save_iterations)
+    assert not epoch_schedule.checkpoint_is_due(12, 1, save_iterations)
+
+
+def test_checkpoint_due_keeps_iteration_mode_semantics():
+    assert not epoch_schedule.checkpoint_is_due(299, 300)
+    assert epoch_schedule.checkpoint_is_due(300, 300)
+    assert not epoch_schedule.checkpoint_is_due(300, 0)
