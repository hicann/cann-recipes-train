new file mode 100644
index 0000000000000000000000000000000000000000..893066c1794dfeef5dbec239865b4ab433e858b8
--- /dev/null
+++ b/tests/ut/test_cvt_data_format_jsonl2json.py
@@ -0,0 +1,95 @@
+"""Tests for the repository-level JSONL-to-JSON conversion script."""
+
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+
+SCRIPT_PATH = Path(__file__).resolve().parents[2] / "cvt_data_format_jsonl2json.sh"
+
+
+def _run_converter(tmp_path, records):
+    input_path = tmp_path / "input.jsonl"
+    output_path = tmp_path / "output.json"
+    input_path.write_text(
+        "\n".join(json.dumps(record, ensure_ascii=False) for record in records) + "\n",
+        encoding="utf-8",
+    )
+
+    result = subprocess.run(
+        ["bash", str(SCRIPT_PATH), str(input_path), str(output_path)],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return result, output_path
+
+
+def _read_output(output_path):
+    return json.loads(output_path.read_text(encoding="utf-8"))
+
+
+def test_prompt_response_format_uses_existing_json_shape(tmp_path):
+    records = [
+        {"prompt": "What is 2 + 2?", "response": "4"},
+        {"prompt": "你好，世界", "response": "你好！"},
+    ]
+
+    result, output_path = _run_converter(tmp_path, records)
+
+    assert result.returncode == 0, result.stderr
+    assert _read_output(output_path) == [
+        {
+            "messages": [
+                {"content": "What is 2 + 2?", "role": "user"},
+                {"content": "4", "role": "assistant"},
+            ],
+            "images": [],
+        },
+        {
+            "messages": [
+                {"content": "你好，世界", "role": "user"},
+                {"content": "你好！", "role": "assistant"},
+            ],
+            "images": [],
+        },
+    ]
+
+
+def test_instruction_input_output_format_remains_unchanged(tmp_path):
+    records = [
+        {
+            "instruction": "Translate the input",
+            "input": "hello",
+            "output": "你好",
+        }
+    ]
+
+    result, output_path = _run_converter(tmp_path, records)
+
+    assert result.returncode == 0, result.stderr
+    assert _read_output(output_path) == [
+        {
+            "messages": [
+                {"content": "Translate the input\nhello", "role": "user"},
+                {"content": "你好", "role": "assistant"},
+            ],
+            "images": [],
+        }
+    ]
+
+
+@pytest.mark.parametrize(
+    ("record", "missing_field"),
+    [
+        ({"prompt": "A prompt without a response"}, "response"),
+        ({"response": "A response without a prompt"}, "prompt"),
+    ],
+)
+def test_prompt_response_format_requires_both_fields(tmp_path, record, missing_field):
+    result, _ = _run_converter(tmp_path, [record])
+
+    assert result.returncode != 0
+    assert missing_field in (result.stdout + result.stderr)
