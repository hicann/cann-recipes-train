+def is_pure_lora_training(model: nn.Module) -> bool:
+    """Return whether every trainable parameter belongs to a LoRA adapter.
+
+    A non-empty trainable parameter set is required. This makes adapter-only
+    checkpointing safe for the usual LoRA case while ensuring that mixed
+    training (for example, an unfrozen ``lm_head``) still uses a full model
+    checkpoint so that no trainable weights are lost.
+    """
+    trainable_param_names = [
+        name for name, param in model.named_parameters() if param.requires_grad
+    ]
+    return bool(trainable_param_names) and all(
+        "lora_" in name for name in trainable_param_names
+    )
+
