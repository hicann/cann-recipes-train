index 0000000000000000000000000000000000000000..0bda63e21958400e17a49a6c320cd098df1dd1c1
--- /dev/null
+++ b/mindspeed_mm/fsdp/train/epoch_schedule.py
@@ -0,0 +1,82 @@
+"""Pure helpers for resolving epoch-based training schedules."""
+
+from collections.abc import Collection
+from typing import Optional
+
+
+def get_epoch_micro_batches(dataloader) -> tuple[int, Optional[int]]:
+    """Return local micro-batches and, when known, active global samples.
+
+    A standard PyTorch DataLoader reports batches from ``__len__``. The
+    project's BaseRandomBatchSampler historically reports global samples
+    instead, so samplers exposing its accounting attributes are normalized.
+    """
+    batch_sampler = getattr(dataloader, "batch_sampler", None)
+    sampler_attributes = (
+        "total_samples",
+        "last_batch_size",
+        "micro_batch_times_data_parallel_size",
+    )
+    if batch_sampler is not None and all(
+        hasattr(batch_sampler, name) for name in sampler_attributes
+    ):
+        active_train_samples = batch_sampler.total_samples - batch_sampler.last_batch_size
+        global_micro_batch_size = batch_sampler.micro_batch_times_data_parallel_size
+        if global_micro_batch_size <= 0:
+            raise ValueError("The sampler's global micro-batch size must be positive.")
+        return active_train_samples // global_micro_batch_size, active_train_samples
+
+    return len(dataloader), None
+
+
+def resolve_epoch_schedule(
+    micro_batches_per_epoch: int,
+    gradient_accumulation_steps: int,
+    train_epochs: int,
+    save_interval_epochs: int,
+) -> tuple[int, list[int]]:
+    """Convert epoch settings to total iterations and exact save iterations.
+
+    Each epoch boundary is rounded up to the first optimizer iteration that
+    crosses it. This avoids checkpoint drift for non-divisible dataset sizes.
+    """
+    if train_epochs <= 0:
+        raise ValueError("train_epochs must be a positive integer.")
+    if save_interval_epochs < 0:
+        raise ValueError("save_interval must be >= 0.")
+    if micro_batches_per_epoch <= 0:
+        raise ValueError("micro_batches_per_epoch must be a positive integer.")
+    if gradient_accumulation_steps <= 0:
+        raise ValueError("gradient_accumulation_steps must be a positive integer.")
+    if micro_batches_per_epoch < gradient_accumulation_steps:
+        raise ValueError(
+            f"Cannot train by epochs because the dataloader has {micro_batches_per_epoch} "
+            f"micro-batches per epoch, which is smaller than gradient_accumulation_steps "
+            f"({gradient_accumulation_steps}). Reduce gradient accumulation or specify "
+            f"train_iters directly."
+        )
+
+    def _iteration_at_epoch(epoch: int) -> int:
+        micro_batches = epoch * micro_batches_per_epoch
+        return (micro_batches + gradient_accumulation_steps - 1) // gradient_accumulation_steps
