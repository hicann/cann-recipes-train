@@ -0,0 +1,137 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "${script_dir}"
+
+if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
+  echo "Usage: bash $0 <config> [npu_count]" >&2
+  exit 2
+fi
+
+config="$1"
+training_npu_count="${2:-${NPUS_PER_NODE:-16}}"
+if [[ ! "${training_npu_count}" =~ ^[1-9][0-9]*$ ]]; then
+  echo "npu_count must be a positive integer, got: ${training_npu_count}" >&2
+  exit 2
+fi
+
+visible_npu_devices="${ASCEND_RT_VISIBLE_DEVICES:-}"
+if [ -n "${visible_npu_devices}" ]; then
+  npu_device_ids="${visible_npu_devices//[[:space:]]/}"
+else
+  npu_device_ids=""
+  for ((device_id = 0; device_id < training_npu_count; device_id++)); do
+    if [ -n "${npu_device_ids}" ]; then
+      npu_device_ids+=","
+    fi
+    npu_device_ids+="${device_id}"
+  done
+fi
+
+if [[ ! "${npu_device_ids}" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
+  echo "Invalid NPU device list: ${npu_device_ids}" >&2
+  exit 2
+fi
+IFS=',' read -r -a selected_npu_devices <<< "${npu_device_ids}"
+if [ "${#selected_npu_devices[@]}" -ne "${training_npu_count}" ]; then
+  echo "ASCEND_RT_VISIBLE_DEVICES selects ${#selected_npu_devices[@]} device(s), " \
+    "but npu_count is ${training_npu_count}: ${npu_device_ids}" >&2
+  exit 2
+fi
+declare -A seen_npu_devices=()
+for device_id in "${selected_npu_devices[@]}"; do
+  if [ -n "${seen_npu_devices[${device_id}]:-}" ]; then
+    echo "Duplicate NPU device ID: ${device_id}" >&2
+    exit 2
+  fi
+  seen_npu_devices[${device_id}]=1
+done
+
+wait_script="scripts/wait_for_npu_idle.sh"
+train_script="examples/qwen3_6/finetune_qwen3_6_27B.sh"
+convert_script="cvt_ckpt_dcp2hf_batch.sh"
+
+if [ ! -f "${config}" ]; then
+  echo "Config file does not exist: ${config}" >&2
+  exit 1
+fi
+
+if [ ! -f "${wait_script}" ]; then
+  echo "NPU wait script does not exist: ${wait_script}" >&2
+  exit 1
+fi
+
+if [ ! -f "${train_script}" ]; then
+  echo "Training script does not exist: ${train_script}" >&2
+  exit 1
+fi
+
+if [ ! -f "${convert_script}" ]; then
+  echo "Checkpoint conversion script does not exist: ${convert_script}" >&2
+  exit 1
+fi
+
+dcp_dir="$(
+  python -c '
+import sys
+import yaml
+
+with open(sys.argv[1], encoding="utf-8") as config_file:
+    config = yaml.safe_load(config_file) or {}
+
+save = config.get("training", {}).get("save")
+if not isinstance(save, str) or not save.strip():
+    raise SystemExit(f"training.save is missing or empty in config: {sys.argv[1]}")
+
+print(save)
+' "${config}"
+)"
+save_hf_dir="${dcp_dir%/}-hf"
+expected_npu_count="${EXPECTED_NPU_COUNT:-16}"
+
+mkdir -p logs
+
+config_name="$(basename "${config}")"
+config_name="${config_name%.*}"
+tag="${config_name}_$(date +%Y%m%d_%H%M%S)"
+pidfile="logs/${tag}.pid"
+workflow_log="logs/${tag}_workflow.log"
+
+nohup bash -c '
+  set -euo pipefail
+
+  wait_script="$1"
+  train_script="$2"
+  config="$3"
+  convert_script="$4"
+  dcp_dir="$5"
+  save_hf_dir="$6"
+  expected_npu_count="$7"
+  training_npu_count="$8"
+  npu_device_ids="$9"
+
+  echo "Waiting for physical NPU device(s) ${npu_device_ids} to become idle."
+  NPU_DEVICE_IDS="${npu_device_ids}" EXPECTED_NPU_COUNT="${expected_npu_count}" \
+    NPUS_PER_NODE="${training_npu_count}" \
+    bash "${wait_script}" "${train_script}" "${config}"
+
+  echo "Training completed. Starting checkpoint post-processing."
+  bash "${convert_script}" "${dcp_dir}" "${save_hf_dir}" "${config}"
+' _ "${wait_script}" "${train_script}" "${config}" "${convert_script}" \
+  "${dcp_dir}" "${save_hf_dir}" "${expected_npu_count}" "${training_npu_count}" \
+  "${npu_device_ids}" \
+  </dev/null >"${workflow_log}" 2>&1 &
+
+pid=$!
+printf '%s\n' "$pid" > "$pidfile"
+disown "$pid"
+
+echo "PID: $pid"
+echo "PID file: $pidfile"
+echo "Workflow log: $workflow_log"
+echo "Training config: $config"
+echo "Training NPU count: $training_npu_count"
+echo "Physical NPU device IDs: $npu_device_ids"
+echo "Checkpoint output dir: $dcp_dir"
+echo "DCP-to-HF output prefix: $save_hf_dir"
diff --git a/scripts/wait_for_npu_idle.sh b/scripts/wait_for_npu_idle.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ea2d0f081526b93d4b2991431d4affc9dcbbfe71
--- /dev/null
+++ b/scripts/wait_for_npu_idle.sh
@@ -0,0 +1,190 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+# Wait until every visible NPU only has its baseline memory allocation, then
+# replace this watcher with the requested shell script.
+#
+# Optional environment variables:
+#   IDLE_MEMORY_THRESHOLD_MB  Maximum idle memory per NPU (default: 4000)
+#   CHECK_INTERVAL_SECONDS    Delay between checks (default: 300)
+#   QUERY_TIMEOUT_SECONDS     Timeout for each npu-smi query (default: 30)
+#   EXPECTED_NPU_COUNT        Expected physical NPU count. A filtered result
+#                             matching NPU_DEVICE_IDS count is also accepted.
+#   NPU_DEVICE_IDS            Comma-separated physical NPU IDs to check. When
+#                             unset, check every NPU reported by npu-smi.
+
+idle_memory_threshold_mb="${IDLE_MEMORY_THRESHOLD_MB:-4000}"
+check_interval_seconds="${CHECK_INTERVAL_SECONDS:-300}"
+query_timeout_seconds="${QUERY_TIMEOUT_SECONDS:-30}"
+expected_npu_count="${EXPECTED_NPU_COUNT:-}"
+npu_device_ids="${NPU_DEVICE_IDS:-}"
+minimum_device_memory_mb=4096
+
+usage() {
+    echo "Usage: bash $0 <target.sh> [target arguments ...]"
+}
+
+log() {
+    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
+}
+
+is_non_negative_integer() {
+    [[ "$1" =~ ^[0-9]+$ ]]
+}
+
+parse_memory_usage() {
+    awk -v minimum_capacity="${minimum_device_memory_mb}" '
+        {
+            gsub(/\|/, " ")
+            for (field = 1; field <= NF; field++) {
+                used = ""
+                total = ""
+
+                if ($field ~ /^[0-9]+\/[0-9]+$/) {
+                    split($field, memory, "/")
+                    used = memory[1]
+                    total = memory[2]
+                } else if ($field ~ /^[0-9]+$/ && $(field + 1) == "/" && $(field + 2) ~ /^[0-9]+$/) {
+                    used = $field
+                    total = $(field + 2)
+                    field += 2
+                }
+
+                # This excludes unrelated ratios such as Hugepages-Usage (0/0).
+                if (total != "" && total + 0 >= minimum_capacity) {
+                    print used + 0
+                }
+            }
+        }
+    '
+}
+
+query_npu_smi() {
+    # ASCEND_RT_VISIBLE_DEVICES also filters npu-smi output on some systems.
+    # Try to query the full physical-device view. Some container runtimes still
+    # expose only the assigned devices; that filtered view is handled below.
+    # The target training process keeps the original visibility setting because
+    # the unset only happens in a subshell.
+    (
+        unset ASCEND_RT_VISIBLE_DEVICES
+        timeout "${query_timeout_seconds}" npu-smi info
+    )
+}
+
+if [ "$#" -lt 1 ]; then
+    usage
+    exit 2
+fi
+
+target_script="$1"
+shift
+
+if [ ! -f "${target_script}" ]; then
+    echo "Target script does not exist: ${target_script}" >&2
+    exit 2
+fi
+
+for value_name in idle_memory_threshold_mb check_interval_seconds query_timeout_seconds; do
+    value="${!value_name}"
+    if ! is_non_negative_integer "${value}"; then
+        echo "${value_name} must be a non-negative integer, got: ${value}" >&2
+        exit 2
+    fi
+done
+
+if [ -n "${expected_npu_count}" ] && ! is_non_negative_integer "${expected_npu_count}"; then
+    echo "EXPECTED_NPU_COUNT must be a non-negative integer, got: ${expected_npu_count}" >&2
+    exit 2
+fi
+
+selected_device_ids=()
+if [ -n "${npu_device_ids}" ]; then
+    if [[ ! "${npu_device_ids}" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
+        echo "NPU_DEVICE_IDS must be comma-separated non-negative integers, got: ${npu_device_ids}" >&2
+        exit 2
+    fi
+    IFS=',' read -r -a selected_device_ids <<< "${npu_device_ids}"
+    declare -A seen_device_ids=()
+    for device_id in "${selected_device_ids[@]}"; do
+        if [ -n "${seen_device_ids[${device_id}]:-}" ]; then
+            echo "NPU_DEVICE_IDS contains duplicate device ID: ${device_id}" >&2
+            exit 2
+        fi
+        seen_device_ids[${device_id}]=1
+    done
+fi
+
+if ! command -v npu-smi >/dev/null 2>&1; then
+    echo "npu-smi was not found in PATH" >&2
+    exit 127
+fi
+
+while true; do
+    if ! npu_smi_output="$(query_npu_smi 2>&1)"; then
+        log "npu-smi query failed or timed out; retrying in ${check_interval_seconds}s."
+        sleep "${check_interval_seconds}"
+        continue
+    fi
+
+    mapfile -t memory_usages < <(printf '%s\n' "${npu_smi_output}" | parse_memory_usage)
+
+    if [ "${#memory_usages[@]}" -eq 0 ]; then
+        log "No NPU memory data could be parsed; retrying in ${check_interval_seconds}s."
+        sleep "${check_interval_seconds}"
+        continue
+    fi
+
+    if [ "${#selected_device_ids[@]}" -eq 0 ]; then
+        selected_device_ids=("${!memory_usages[@]}")
+    fi
+
+    reported_device_count="${#memory_usages[@]}"
+    selected_device_count="${#selected_device_ids[@]}"
+    if [ -n "${expected_npu_count}" ] \
+        && [ "${reported_device_count}" -ne "${expected_npu_count}" ] \
+        && [ "${reported_device_count}" -ne "${selected_device_count}" ]; then
+        log "Found ${reported_device_count} NPU memory entries; expected ${expected_npu_count} physical or ${selected_device_count} selected; retrying in ${check_interval_seconds}s."
+        sleep "${check_interval_seconds}"
+        continue
+    fi
+
+    memory_entry_indexes=()
+    if [ "${reported_device_count}" -eq "${selected_device_count}" ]; then
+        # npu-smi is already filtered to the visible devices. Its entries are
+        # positional, so map them to the physical IDs supplied by the launcher.
+        memory_entry_indexes=("${!memory_usages[@]}")
+        log "npu-smi reported the ${reported_device_count} selected device(s); mapping entries to physical NPU device(s) ${selected_device_ids[*]}."
+    else
+        # npu-smi returned the full physical-device view; physical IDs can be
+        # used directly as indexes.
+        for device_id in "${selected_device_ids[@]}"; do
+            if [ "${device_id}" -ge "${reported_device_count}" ]; then
+                echo "Selected NPU device ID ${device_id} is unavailable; " \
+                    "npu-smi reported ${reported_device_count} device(s)." >&2
+                exit 2
+            fi
+            memory_entry_indexes+=("${device_id}")
+        done
+    fi
+
+    all_idle=true
+    for selected_index in "${!selected_device_ids[@]}"; do
+        device_id="${selected_device_ids[selected_index]}"
+        memory_entry_index="${memory_entry_indexes[selected_index]}"
+        used_mb="${memory_usages[memory_entry_index]}"
+        if [ "${used_mb}" -gt "${idle_memory_threshold_mb}" ]; then
+            log "NPU ${device_id}: ${used_mb} MB used (busy; threshold ${idle_memory_threshold_mb} MB)."
+            all_idle=false
+        else
+            log "NPU ${device_id}: ${used_mb} MB used (idle)."
+        fi
+    done
+
+    if [ "${all_idle}" = true ]; then
+        log "Selected NPU device(s) ${selected_device_ids[*]} are idle; starting: bash ${target_script} $*"
+        exec bash "${target_script}" "$@"
+    fi
+
+    log "At least one selected NPU is busy; retrying in ${check_interval_seconds}s."
+    sleep "${check_interval_seconds}"
+done
