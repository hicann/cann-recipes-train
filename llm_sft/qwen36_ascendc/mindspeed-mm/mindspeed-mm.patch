@@ -0,0 +1,72 @@
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import torch.nn as nn
+
+from mindspeed_mm.fsdp.train.train_engine import TrainEngine
+
+
+class PureLoraModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.base = nn.Linear(4, 4, bias=False)
+        self.base.requires_grad_(False)
+        self.lora_A = nn.Linear(4, 2, bias=False)
+        self.lora_B = nn.Linear(2, 4, bias=False)
+
+
+def build_engine(*, save_full_model: bool) -> TrainEngine:
+    engine = TrainEngine.__new__(TrainEngine)
+    engine.args = SimpleNamespace(
+        training=SimpleNamespace(
+            lora=SimpleNamespace(
+                enable=True,
+                save_full_model=save_full_model,
+            ),
+            save="/tmp/test-lora-save",
+            save_dtype="bf16",
+            no_save_optim=True,
+            no_save_rng=True,
+        )
+    )
+    engine.model = PureLoraModel()
+    engine.lora_weight_manager = MagicMock()
+    engine.checkpointer = MagicMock()
+    engine.lr_scheduler = MagicMock()
+    engine.train_dataloader = MagicMock()
+    return engine
+
+
+def test_pure_lora_save_skips_full_checkpoint_by_default() -> None:
+    engine = build_engine(save_full_model=False)
+
+    with patch("mindspeed_mm.fsdp.train.train_engine.torch.distributed.barrier") as barrier:
+        engine.save(iteration=12, consumed_train_samples=24)
+
+    engine.lora_weight_manager.save_lora_only.assert_called_once_with(
+        save_path="/tmp/test-lora-save",
+        iteration=12,
+    )
+    engine.checkpointer.save.assert_not_called()
+    barrier.assert_called_once_with()
+
+
+def test_pure_lora_save_can_force_full_checkpoint() -> None:
+    engine = build_engine(save_full_model=True)
+
+    with patch("mindspeed_mm.fsdp.train.train_engine.torch.distributed.barrier"):
+        engine.save(iteration=12, consumed_train_samples=24)
+
+    engine.lora_weight_manager.save_lora_only.assert_called_once()
+    engine.checkpointer.save.assert_called_once()
+
+
+def test_mixed_training_keeps_full_checkpoint() -> None:
+    engine = build_engine(save_full_model=False)
+    engine.model.base.weight.requires_grad_(True)
+
+    with patch("mindspeed_mm.fsdp.train.train_engine.torch.distributed.barrier"):
+        engine.save(iteration=12, consumed_train_samples=24)
+
+    engine.lora_weight_manager.save_lora_only.assert_called_once()
+    engine.checkpointer.save.assert_called_once()
diff --git a/tests/ut_fsdp/test_epoch_training.py b/tests/ut_fsdp/test_epoch_training.py
