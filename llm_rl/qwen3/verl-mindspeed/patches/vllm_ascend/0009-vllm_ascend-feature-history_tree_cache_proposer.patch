+import os
+import threading
+import torch
+import numpy as np
+from typing import Optional
+from vllm.config import CUDAGraphMode, VllmConfig
+from vllm.v1.core.sched.output import SchedulerOutput
+from vllm.v1.sample.metadata import SamplingMetadata
+from vllm.v1.spec_decode.metadata import SpecDecodeMetadata
+from vllm_ascend.spec_decode.interface import Proposer, SpecDcodeType
+from vllm_ascend.spec_decode.global_module.prefix_tree import make_history_prompt_id
+
+
+class FixedDraftHistoryCache:
+    def __init__(self, draft_len: int):
+        self.draft_len = draft_len
+        self.prefix_len = 2
+        self._cache: dict[str, dict[tuple[int, int], tuple[float, int, tuple[int, ...]]]] = {}
+        self._global_cache: dict[tuple[int, int], tuple[float, int, tuple[int, ...]]] = {}
+        self._lock = threading.Lock()
+
+    def clear(self) -> None:
+        with self._lock:
+            self._cache.clear()
+            self._global_cache.clear()
+
+    def update_records(self, records: list[dict], normalize_token_list) -> int:
+        if not records:
+            return 0
+
+        updated = 0
+        with self._lock:
+            for record in records:
+                prompt_id = str(record.get("prompt_id", ""))
+                if not prompt_id:
+                    continue
+
+                response_token_ids = normalize_token_list(
+                    record.get("response_token_ids"))
+                if len(response_token_ids) <= self.prefix_len:
+                    continue
+
+                try:
+                    reward = float(record.get("reward", 0.0))
+                except (TypeError, ValueError):
+                    reward = 0.0
+
+                prompt_cache = self._cache.setdefault(prompt_id, {})
+                max_start = len(response_token_ids) - self.prefix_len
+                for start in range(max_start):
+                    prefix = tuple(
+                        response_token_ids[start:start + self.prefix_len])
+                    draft = tuple(
+                        response_token_ids[start + self.prefix_len:start +
+                                           self.prefix_len + self.draft_len])
+                    if len(draft) != self.draft_len:
+                        continue
+
+                    prev = prompt_cache.get(prefix)
+                    candidate = (reward, len(draft), draft)
+                    if prev is None or candidate[:2] > prev[:2]:
+                        prompt_cache[prefix] = candidate
+                        updated += 1
+
+                    global_prev = self._global_cache.get(prefix)
+                    if global_prev is None or candidate[:2] > global_prev[:2]:
+                        self._global_cache[prefix] = candidate
+        return updated
+
+    def predict_batch(self, prompt_id_list: list[str],
+                      sampled_token_id_list: list[list[int]]) -> list[list[int]]:
+        if not prompt_id_list:
+            return []
+
+        result = []
+        with self._lock:
+            for prompt_id, sampled_ids in zip(prompt_id_list,
+                                              sampled_token_id_list):
+                if len(sampled_ids) < self.prefix_len:
+                    result.append([])
+                    continue
+                prompt_cache = self._cache.get(prompt_id)
+                prefix = tuple(sampled_ids[-self.prefix_len:])
+                candidate = None
+                if prompt_cache is not None:
+                    candidate = prompt_cache.get(prefix)
+                if candidate is None:
+                    candidate = self._global_cache.get(prefix)
+                result.append(list(candidate[2]) if candidate else [])
+        return result
+
+class HistoryRolloutProposer(Proposer):
+    def __init__(self, vllm_config, device, runner):
+        self.name = SpecDcodeType.HISTO
+        self.device = device
+        self.runner = runner
+        self.num_speculative_tokens = vllm_config.speculative_config.num_speculative_tokens
+        self.vocab_size = vllm_config.model_config.get_vocab_size()
+
+        # Minimum length of the HistoryRolloutTree to match.
+        self.min_n = 2
+        # Maximum length of the HistoryRolloutTree to match.
+        self.max_n = vllm_config.speculative_config.prompt_lookup_max
+        self.prompt_lookup = vllm_config.speculative_config.prompt_lookup_max
+        self.history_cache = FixedDraftHistoryCache(
+            draft_len=self.num_speculative_tokens)
+        self.max_spec_reqs = int(
+            os.getenv("VLLM_HISTORY_TREE_MAX_SPEC_REQS", "64"))
+        self._predict_times = 0
+        self._effective_times = 0
+        self._total_right_length = 0
+
+    def _normalize_token(self, token) -> Optional[int]:
+        if isinstance(token, torch.Tensor):
+            if token.numel() != 1:
+                return None
+            token = token.item()
+        elif isinstance(token, np.generic):
+            token = token.item()
+
+        try:
+            token = int(token)
+        except (TypeError, ValueError):
+            return None
+
+        if token < 0 or token >= self.vocab_size:
+            return None
+        return token
+
+    def _normalize_token_list(self, tokens) -> list[int]:
+        if tokens is None:
+            return []
+
+        normalized = []
+        for token in tokens:
+            normalized_token = self._normalize_token(token)
+            if normalized_token is None:
+                break
+            normalized.append(normalized_token)
+            if len(normalized) >= self.num_speculative_tokens:
+                break
+        return normalized
+
+    def _normalize_history_record_token_list(self, tokens) -> list[int]:
+        if tokens is None:
+            return []
+
+        normalized = []
+        for token in tokens:
+            normalized_token = self._normalize_token(token)
+            if normalized_token is None:
+                break
+            normalized.append(normalized_token)
+        return normalized
+
+    def _normalize_batch_draft_tokens(self, batch_draft_tokens, batch_size: int) -> list[list[int]]:
+        if batch_draft_tokens is None:
+            return [[] for _ in range(batch_size)]
+
+        normalized_batch = []
+        for i in range(batch_size):
+            if i >= len(batch_draft_tokens):
+                normalized_batch.append([])
+            else:
+                normalized_batch.append(
+                    self._normalize_token_list(batch_draft_tokens[i]))
+        return normalized_batch
+
+    def reset_history_cache(self) -> None:
+        self.history_cache.clear()
+
+    def sync_records(self, records: list[dict]) -> int:
+        updated = self.history_cache.update_records(
+            records,
+            self._normalize_history_record_token_list,
+        )
+        return updated
+
+    def get_metrics(self, reset: bool = False) -> dict[str, float]:
+        predict_times = self._predict_times
+        effective_times = self._effective_times
+        total_right_length = self._total_right_length
+        if reset:
+            self._predict_times = 0
+            self._effective_times = 0
+            self._total_right_length = 0
+        return {
+            "predict_times": float(predict_times),
+            "effective_times": float(effective_times),
+            "total_right_length": float(total_right_length),
+        }
+
+    def propose(
+        self,
+        accept_length: int,
+        sampled_token_ids: list[int],
+        prompt_token_ids: list[int],
+        *,
+        count_metrics: bool = True,
+    ) -> Optional[np.ndarray]:
+        """Proposes the next sequence of tokens based on history rollout
+        speculative decoding pattern.
+        """
+        prompt_id = make_history_prompt_id(prompt_token_ids)
+        if len(sampled_token_ids) < self.min_n:
+            return []
+        draft_tokens = self.history_cache.predict_batch(
+            [prompt_id], [sampled_token_ids])
+        draft_tokens = self._normalize_token_list(
+            draft_tokens[0] if draft_tokens else [])
+        if count_metrics and draft_tokens:
+            self._predict_times += 1
+            if accept_length > 1:
+                self._effective_times += 1
+                self._total_right_length += (accept_length - 1)
+        return draft_tokens
+
+    def propose_batch(
+        self,
+        accept_length_list: list[int],
+        sampled_token_id_list: list[list[int]],
+        prompt_token_id_list: list[list[int]],
+        *,
+        count_metrics: bool = True,
+    ) -> Optional[np.ndarray]:
+        """Proposes the next sequence of tokens based on history rollout
+        speculative decoding pattern.
+        """
+        batch_size = len(accept_length_list)
+        if self.max_spec_reqs > 0 and batch_size > self.max_spec_reqs:
+            return [[] for _ in range(batch_size)]
+
+        normalized_batch = [[] for _ in range(batch_size)]
+        eligible_indices = []
+        eligible_prompt_ids = []
+        eligible_sampled_token_ids = []
+        for i in range(batch_size):
+            sampled_ids = sampled_token_id_list[i]
+            if len(sampled_ids) < self.min_n:
+                continue
+            prompt_token_ids = prompt_token_id_list[i]
+            if not prompt_token_ids:
+                continue
+            eligible_indices.append(i)
+            eligible_prompt_ids.append(make_history_prompt_id(prompt_token_ids))
+            eligible_sampled_token_ids.append(sampled_ids)
+
+        if eligible_indices:
+            batch_draft_tokens = self.history_cache.predict_batch(
+                eligible_prompt_ids,
+                eligible_sampled_token_ids,
+            )
+            normalized_eligible_batch = self._normalize_batch_draft_tokens(
+                batch_draft_tokens, len(eligible_indices))
+            for dst_idx, draft_tokens in zip(eligible_indices,
+                                             normalized_eligible_batch):
+                normalized_batch[dst_idx] = draft_tokens
+            if count_metrics:
+                for local_idx, draft_tokens in enumerate(normalized_eligible_batch):
+                    if not draft_tokens:
+                        continue
+                    self._predict_times += 1
+                    accept_length = int(accept_length_list[eligible_indices[local_idx]])
+                    if accept_length > 1:
+                        self._effective_times += 1
+                        self._total_right_length += (accept_length - 1)
+
+        return normalized_batch
+
+    def load_model(self, model):
+        # No model to load.
+        pass
+
+    @torch.inference_mode()
+    def dummy_run(self,
+                  num_tokens: int,
+                  with_prefill: bool = False,
+                  in_graph_capturing: bool = False,
+                  num_reqs: int = 0,
