+    def _start_spec_timer(self, spec_timing_info: dict[str, Any] | None):
+        if spec_timing_info is None:
+            return None
+        start_event = torch.npu.Event(enable_timing=True)
+        end_event = torch.npu.Event(enable_timing=True)
+        start_event.record()
+        return start_event, end_event
+
+    def _wait_num_accepted_tokens_copy(self) -> None:
+        if self._num_accepted_tokens_copy_pending:
+            self._num_accepted_tokens_copy_event.synchronize()
+            self._num_accepted_tokens_copy_pending = False
+
+    def _end_spec_timer(
+        self,
+        spec_timing_info: dict[str, Any] | None,
+        key: str,
+        start_time: Any,
+    ) -> None:
+        if spec_timing_info is None or start_time is None:
+            return
+        start_event, end_event = start_time
+        end_event.record()
+        spec_timing_info.setdefault("_pending_events", []).append(
+            (key, start_event, end_event))
+
+    def _finalize_spec_timing(
+        self,
+        spec_timing_info: dict[str, Any] | None,
+    ) -> None:
+        if spec_timing_info is None:
+            return
+        pending_events = spec_timing_info.pop("_pending_events", None)
+        if not pending_events:
+            return
+        for key, start_event, end_event in pending_events:
+            end_event.synchronize()
+            spec_timing_info[key] = start_event.elapsed_time(end_event)
+
+    def _emit_spec_timing(self, spec_timing_info: dict[str, Any] | None):
+        if spec_timing_info is None:
+            return
+        self._finalize_spec_timing(spec_timing_info)
+
