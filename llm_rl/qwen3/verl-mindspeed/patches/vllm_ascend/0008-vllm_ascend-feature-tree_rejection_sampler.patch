@@ -0,0 +1,616 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from typing import Optional
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.triton_utils import tl, triton
+from vllm.v1.outputs import SamplerOutput
+from vllm.v1.sample.metadata import SamplingMetadata
+from vllm.v1.sample.sampler import Sampler
+from vllm.v1.spec_decode.metadata import SpecDecodeMetadata
+from vllm.v1.sample.rejection_sampler import RejectionSampler
+from vllm.v1.spec_decode.tree_draft_params import TreeDrafterParams
+from vllm_ascend.sample.sampler import apply_top_k_top_p
+
+logger = init_logger(__name__)
+
+BLOCK_SIZE: int = 64
+PLACEHOLDER_TOKEN_ID = -1
+
+class AscendTreeRejectionSampler(RejectionSampler):
+
+    def __init__(
+        self,
+        tree_drafter_params: TreeDrafterParams,
+        max_batch_size: int,
+        sampler: Sampler,
+        device: Optional[torch.device],
+    ):
+        super().__init__(sampler)
+        self.device = device
+        self.tree_mask = torch.tensor(
+            tree_drafter_params.attn_mask, device=device, dtype=torch.bool
+        )[:, 1:].contiguous()
+        # Cumulative # of tokens per level, including the root token.
+        self.cu_tokens_per_level = [
+            num_drafts + 1
+            for num_drafts in tree_drafter_params.cu_drafts_per_level
+        ]
+
+        # Get tree depth (# levels) and width (# drafts at last level).
+
+        self.tree_depth = len(self.cu_tokens_per_level)
+        self.tree_width = self.cu_tokens_per_level[
+            -1] - self.cu_tokens_per_level[-2]
+        self.tree_size = self.cu_tokens_per_level[-1]
+
+        # Get per-level slices of draft indices, and per-level indices
+        # for their corresponding parents.
+        num_children_per_level = tree_drafter_params.child_drafts_per_level
+        self.draft_slices = [(0, 0)]
+        self.parent_indices: list[list[int]] = [[]]
+        parents_end = 0
+        for level in range(1, self.tree_depth):
+            # Add slice of draft indices for this level.
+            self.draft_slices.append((self.cu_tokens_per_level[level - 1],
+                                      self.cu_tokens_per_level[level]))
+            # Add indices for this level's parents.
+            parents_start = parents_end
+            parents_end = self.cu_tokens_per_level[level - 1]
+            num_children = num_children_per_level[level - 1]
+            indices = []
+            for parent_idx in range(parents_start, parents_end):
+                indices += [parent_idx] * num_children
+            self.parent_indices.append(indices)
+
+        # Precompute indices for logits corresponding to tree-internal
+        # tokens across batches.
+        self.tree_internal_size = self.cu_tokens_per_level[-2]
+        self.tree_index_offsets = torch.arange(
+            self.tree_size, device=device, dtype=torch.int32)
+        self.tree_internal_index_offsets = self.tree_index_offsets[
+            :self.tree_internal_size].contiguous()
+        self.draft_index_offsets = self.tree_index_offsets[:self.tree_size - 1].contiguous()
+
+        self.parent_index_tensors: list[Optional[torch.Tensor]] = [None]
+        for indices in self.parent_indices[1:]:
+            self.parent_index_tensors.append(
+                torch.tensor(indices, device=device, dtype=torch.long))
+
+        self.children_by_tree_idx, self.leaf_paths = self._build_leaf_paths()
+        self.leaf_path_tensors = [
+            torch.tensor(path, device=device, dtype=torch.long)
+            for path in self.leaf_paths
+        ]
+        self.leaf_parent_row_tensors = [
+            torch.tensor([0] + [idx + 1 for idx in path[:-1]],
+                         device=device,
+                         dtype=torch.long)
+            for path in self.leaf_paths
+        ]
+        self.leaf_bonus_rows = torch.tensor(
+            [path[-1] + 1 for path in self.leaf_paths],
+            device=device,
+            dtype=torch.long,
+        )
+        self._num_draft_tokens = torch.empty(
+            max_batch_size, device=device, dtype=torch.int32
+        )
+        self._start_indices = torch.empty(
+            max_batch_size, device=device, dtype=torch.int32
+        )
+        self._accepted_index_offsets = torch.empty(
+            max_batch_size, device=device, dtype=torch.int32
+        )
+        self._req_indices_long = torch.arange(
+            max_batch_size, device=device, dtype=torch.long
+        )
+
+    def _build_leaf_paths(self) -> tuple[list[list[int]], list[list[int]]]:
+        children_by_tree_idx = [[] for _ in range(self.tree_size)]
+        for level in range(1, self.tree_depth):
+            start, end = self.draft_slices[level]
+            parents = self.parent_indices[level]
+            for tree_idx, parent_tree_idx in zip(range(start, end), parents):
+                children_by_tree_idx[parent_tree_idx].append(tree_idx)
+
+        leaf_paths: list[list[int]] = []
+
+        def dfs(tree_idx: int, path: list[int]) -> None:
+            if tree_idx != 0:
+                path = path + [tree_idx - 1]
+            if not children_by_tree_idx[tree_idx]:
+                if path:
+                    leaf_paths.append(path)
+                return
+            for child in children_by_tree_idx[tree_idx]:
+                dfs(child, path)
+
+        dfs(0, [])
+        return children_by_tree_idx, leaf_paths
+
+    def _clone_sampling_metadata(self,
+                                 sampling_metadata: SamplingMetadata,
+                                 num_reqs: int) -> SamplingMetadata:
+        cloned_generators: dict[int, torch.Generator] = {}
+        for req_idx, generator in sampling_metadata.generators.items():
+            if req_idx >= num_reqs:
+                continue
+            cloned_generators[req_idx] = generator.clone_state()
+
+        return SamplingMetadata(
+            temperature=sampling_metadata.temperature[:num_reqs].clone()
+            if sampling_metadata.temperature is not None else None,
+            all_greedy=sampling_metadata.all_greedy,
+            all_random=sampling_metadata.all_random,
+            top_p=sampling_metadata.top_p[:num_reqs].clone()
+            if sampling_metadata.top_p is not None else None,
+            top_k=sampling_metadata.top_k[:num_reqs].clone()
+            if sampling_metadata.top_k is not None else None,
+            generators=cloned_generators,
+            max_num_logprobs=None,
+            no_penalties=sampling_metadata.no_penalties,
+            prompt_token_ids=sampling_metadata.prompt_token_ids[:num_reqs].clone()
+            if sampling_metadata.prompt_token_ids is not None else None,
+            frequency_penalties=sampling_metadata.frequency_penalties[:num_reqs].clone(),
+            presence_penalties=sampling_metadata.presence_penalties[:num_reqs].clone(),
+            repetition_penalties=sampling_metadata.repetition_penalties[:num_reqs].clone(),
+            output_token_ids=[list(tokens)
+                              for tokens in sampling_metadata.output_token_ids[:num_reqs]],
+            allowed_token_ids_mask=(
+                sampling_metadata.allowed_token_ids_mask[:num_reqs].clone()
+                if sampling_metadata.allowed_token_ids_mask is not None else None),
+            bad_words_token_ids={
+                req_idx: bad_words
+                for req_idx, bad_words in sampling_metadata.bad_words_token_ids.items()
+                if req_idx < num_reqs
+            },
+            logitsprocs=sampling_metadata.logitsprocs,
+            spec_token_ids=(
+                [list(tokens)
+                 for tokens in sampling_metadata.spec_token_ids[:num_reqs]]
+                if sampling_metadata.spec_token_ids is not None else None),
+        )
+
+    def _build_branch_metadata(
+        self,
+        draft_token_ids: torch.Tensor,
+        target_logits: torch.Tensor,
+        bonus_logits: torch.Tensor,
+    ) -> SpecDecodeMetadata:
+        num_reqs, branch_len = draft_token_ids.shape
+        flat_draft_token_ids = draft_token_ids.reshape(-1).to(torch.int32).contiguous()
+        num_draft_tokens = [branch_len] * num_reqs
+        cu_num_draft_tokens = torch.arange(
+            1,
+            num_reqs + 1,
+            device=draft_token_ids.device,
+            dtype=torch.int32,
+        ) * branch_len
+        cu_num_sampled_tokens = torch.arange(
+            1,
+            num_reqs + 1,
+            device=draft_token_ids.device,
+            dtype=torch.int32,
+        ) * (branch_len + 1)
+        num_target_logits = num_reqs * branch_len
+        target_logits_indices = torch.arange(
+            num_target_logits,
+            device=draft_token_ids.device,
+            dtype=torch.int32,
+        )
+        bonus_logits_indices = torch.arange(
+            num_reqs,
+            device=draft_token_ids.device,
+            dtype=torch.int32,
+        ) + num_target_logits
+        logits_indices = torch.arange(
+            num_target_logits + num_reqs,
+            device=draft_token_ids.device,
+            dtype=torch.int32,
+        )
+        return SpecDecodeMetadata(
+            draft_token_ids=flat_draft_token_ids,
+            num_draft_tokens=num_draft_tokens,
+            cu_num_draft_tokens=cu_num_draft_tokens,
+            cu_num_sampled_tokens=cu_num_sampled_tokens,
+            target_logits_indices=target_logits_indices,
+            bonus_logits_indices=bonus_logits_indices,
+            logits_indices=logits_indices,
+        )
+
+    def _get_device_rng_state(self):
+        if self.device is None:
+            return None
+        device_type = self.device.type
+        if device_type == "npu" and hasattr(torch, "npu"):
+            return torch.npu.get_rng_state()
+        if device_type == "cuda" and hasattr(torch, "cuda"):
+            return torch.cuda.get_rng_state()
+        return torch.get_rng_state()
+
+    def _set_device_rng_state(self, state) -> None:
+        if state is None or self.device is None:
+            return
+        device_type = self.device.type
+        if device_type == "npu" and hasattr(torch, "npu"):
+            torch.npu.set_rng_state(state)
+            return
+        if device_type == "cuda" and hasattr(torch, "cuda"):
+            torch.cuda.set_rng_state(state)
+            return
+        torch.set_rng_state(state)
+
+    def _forward_legacy(
+        self,
+        metadata: SpecDecodeMetadata,
+        draft_probs: Optional[torch.Tensor],
+        logits: torch.Tensor,
+        sampling_metadata: SamplingMetadata,
+    ) -> SamplerOutput:
+        draft_tree_size = self.tree_size - 1
+        draft_token_ids = metadata.draft_token_ids
+        device = draft_token_ids.device
+
+        num_reqs = len(metadata.num_draft_tokens)
+        num_draft_tokens = self._num_draft_tokens[:num_reqs]
+        num_draft_tokens.copy_(metadata.cu_num_draft_tokens)
+        if num_reqs > 1:
+            num_draft_tokens[1:] -= metadata.cu_num_draft_tokens[:-1]
+        is_tree_decode = num_draft_tokens.eq(draft_tree_size)
+
+        start_indices = self._start_indices[:num_reqs]
+        start_indices.copy_(torch.arange(num_reqs, device=device, dtype=torch.int32))
+        if num_reqs > 1:
+            start_indices[1:] += metadata.cu_num_draft_tokens[:-1]
+        output_token_ids = torch.empty(
+            (num_reqs, draft_tree_size + 1),
+            dtype=torch.int32,
+            device=device,
+        )
+
+        accepted_index_offsets = self._accepted_index_offsets[:num_reqs]
+        accepted_index_offsets.zero_()
+
+        num_tree_decodes = int(is_tree_decode.sum().item())
+        if num_tree_decodes > 0:
+            all_tree_decode = num_tree_decodes == num_reqs
+            if all_tree_decode:
+                logits_by_req = logits.view(num_reqs, self.tree_size, -1)
+                target_token_ids = self.compute_tree_target_token_ids(
+                    logits_by_req[:, :self.tree_internal_size, :].reshape(
+                        -1, logits.shape[-1]
+                    ),
+                    is_tree_decode,
+                    num_tree_decodes,
+                    sampling_metadata,
+                ).view(num_tree_decodes, -1)
+                draft_token_ids_tree = draft_token_ids.view(
+                    num_tree_decodes, draft_tree_size
+                )
+            else:
+                tree_decode_start_indices = start_indices[is_tree_decode]
+                tree_internal_indices = (
+                    tree_decode_start_indices[:, None]
+                    + self.tree_internal_index_offsets[None, :]
+                ).reshape(-1).to(torch.long)
+                target_token_ids = self.compute_tree_target_token_ids(
+                    logits[tree_internal_indices],
+                    is_tree_decode,
+                    num_tree_decodes,
+                    sampling_metadata,
+                ).view(num_tree_decodes, -1)
+
+                draft_start_indices = torch.arange(
+                    num_tree_decodes, device=device, dtype=torch.int32
+                ) * draft_tree_size
+                tree_draft_indices = (
+                    draft_start_indices[:, None]
+                    + self.draft_index_offsets[None, :]
+                ).to(torch.long)
+                draft_token_ids_tree = draft_token_ids[tree_draft_indices]
+
+            path_lengths = torch.zeros(
+                (num_tree_decodes, draft_tree_size + 1),
+                dtype=torch.int32,
+                device=device,
+            )
+            path_lengths[:, 0] = 1
+            for level in range(1, self.tree_depth):
+                start, end = self.draft_slices[level]
+                parent_indices = self.parent_index_tensors[level]
+                sample_match = (
+                    draft_token_ids_tree[:, start - 1:end - 1]
+                    == target_token_ids.index_select(1, parent_indices)
+                )
+                parent_path_lengths = path_lengths.index_select(1, parent_indices)
+                cur_lengths = torch.where(
+                    sample_match & parent_path_lengths.gt(0),
+                    parent_path_lengths + 1,
+                    torch.zeros_like(parent_path_lengths),
+                )
+                path_lengths[:, start:end] = cur_lengths
+            accepted_index_offsets[is_tree_decode] = path_lengths.argmax(
+                dim=-1).to(torch.int32)
+
+        grid_dim_0 = num_reqs
+        grid_dim_1 = triton.cdiv(draft_tree_size, BLOCK_SIZE)
+        grid = (grid_dim_0, grid_dim_1)
+
+        _scatter_accepted_tokens_kernel[grid](
+            draft_token_ids_ptr=draft_token_ids,
+            output_token_ids_ptr=output_token_ids,
+            accepted_offsets_ptr=accepted_index_offsets,
+            tree_mask_ptr=self.tree_mask,
+            draft_tree_size=draft_tree_size,
+            placeholder_token_id=PLACEHOLDER_TOKEN_ID,
+            block_size=BLOCK_SIZE,
+        )
+
+        if num_tree_decodes == num_reqs:
+            logits_by_req = logits.view(num_reqs, self.tree_size, -1)
+            req_indices = self._req_indices_long[:num_reqs]
+            bonus_logits = logits_by_req[
+                req_indices, accepted_index_offsets.to(torch.long)
+            ]
+        else:
+            bonus_token_indices = (start_indices + accepted_index_offsets).to(
+                torch.long
+            )
+            bonus_logits = logits[bonus_token_indices]
+        bonus_sampler_output = self.sampler(
+            logits=bonus_logits,
+            sampling_metadata=sampling_metadata,
+        )
+        output_token_ids[:, -1] = bonus_sampler_output.sampled_token_ids.view(-1)
+        return SamplerOutput(
+            sampled_token_ids=output_token_ids,
+            logprobs_tensors=bonus_sampler_output.logprobs_tensors,
+        )
+
+    def forward(
+        self,
+        metadata: SpecDecodeMetadata,
+        # [num_tokens, vocab_size]
+        draft_probs: Optional[torch.Tensor],
+        # [num_tokens, vocab_size]
+        logits: torch.Tensor,
+        sampling_metadata: SamplingMetadata,
+    ) -> SamplerOutput:
+        """
+        Args:
+            metadata:
+                Metadata for spec decoding.
+            draft_probs (Optional[torch.Tensor]):
+                Probability distribution for the draft tokens. Shape is
+                [num_tokens, vocab_size]. Can be None if probabilities are
+                not provided, which is the case for ngram spec decode.
+            logits (torch.Tensor):
+                Target model's logits probability distribution.
+                Shape is [num_tokens, vocab_size]. Here, probabilities from
+                different requests are flattened into a single tensor because
+                this is the shape of the output logits.
+            sampling_metadata (vllm.v1.sample.metadata.SamplingMetadata):
+                Additional metadata needed for sampling, such as temperature,
+                top-k/top-p parameters, or other relevant information.
+        Returns:
+            output_token_ids (torch.Tensor):
+                A tensor containing the final output token IDs.
+        """
+        draft_tree_size = self.tree_size - 1
+        draft_token_ids = metadata.draft_token_ids
+        device = draft_token_ids.device
+
+        num_reqs = len(metadata.num_draft_tokens)
+        num_draft_tokens = self._num_draft_tokens[:num_reqs]
+        num_draft_tokens.copy_(metadata.cu_num_draft_tokens)
+        if num_reqs > 1:
+            num_draft_tokens[1:] -= metadata.cu_num_draft_tokens[:-1]
+        is_tree_decode = num_draft_tokens.eq(draft_tree_size)
+        # Keep the legacy fast path only for mixed batches or for methods that
+        # provide explicit draft probabilities. For EAGLE tree decoding the
+        # user-visible correctness requirement is stricter: every leaf branch
+        # should behave exactly like an independent chain speculative decode.
+        if draft_probs is not None or not bool(is_tree_decode.all()):
+            return self._forward_legacy(
+                metadata, draft_probs, logits, sampling_metadata)
+
+        logits_by_req = logits.view(num_reqs, self.tree_size, -1)
+        draft_token_ids_tree = draft_token_ids.view(num_reqs, draft_tree_size)
+
+        output_token_ids = torch.full(
+            (num_reqs, draft_tree_size + 1),
+            PLACEHOLDER_TOKEN_ID,
+            dtype=torch.int32,
+            device=device,
+        )
+
+        branch_outputs: list[torch.Tensor] = []
+        branch_valid_counts: list[torch.Tensor] = []
+        branch_sampling_metadatas: list[SamplingMetadata] = []
+        initial_rng_state = self._get_device_rng_state()
+        branch_rng_states = []
+        for branch_idx, path_tensor in enumerate(self.leaf_path_tensors):
+            parent_rows = self.leaf_parent_row_tensors[branch_idx]
+            bonus_row = int(self.leaf_bonus_rows[branch_idx].item())
+
+            branch_draft_token_ids = draft_token_ids_tree.index_select(1,
+                                                                       path_tensor)
+            branch_target_logits = logits_by_req.index_select(
+                1, parent_rows).reshape(-1, logits.shape[-1]).contiguous()
+            branch_bonus_logits = logits_by_req[:, bonus_row, :].contiguous()
+
+            branch_logits = torch.cat(
+                [branch_target_logits, branch_bonus_logits], dim=0)
+            branch_metadata = self._build_branch_metadata(
+                branch_draft_token_ids,
+                branch_target_logits,
+                branch_bonus_logits,
+            )
+            branch_sampling_metadata = self._clone_sampling_metadata(
+                sampling_metadata, num_reqs)
+            branch_sampling_metadatas.append(branch_sampling_metadata)
+            if initial_rng_state is not None:
+                self._set_device_rng_state(initial_rng_state)
+            branch_sampler_output = super().forward(
+                branch_metadata,
+                None,
+                branch_logits,
+                branch_sampling_metadata,
+            )
+            branch_token_ids = branch_sampler_output.sampled_token_ids
+            branch_outputs.append(branch_token_ids)
+            branch_valid_counts.append(
+                ((branch_token_ids != PLACEHOLDER_TOKEN_ID)
+                 & (branch_token_ids < logits.shape[-1])).sum(dim=-1))
+            if initial_rng_state is not None:
+                branch_rng_states.append(self._get_device_rng_state())
+
+        valid_count_matrix = torch.stack(branch_valid_counts, dim=1)
+        chosen_branch = valid_count_matrix.argmax(dim=1)
+
+        # Advance the real per-request RNG state along the selected branch so
+        # that the next speculative step observes the same random stream as the
+        # standalone chain that produced the chosen path.
+        for req_idx, original_generator in sampling_metadata.generators.items():
+            if req_idx >= num_reqs:
+                continue
+            branch_idx = int(chosen_branch[req_idx].item())
+            chosen_branch_generator = branch_sampling_metadatas[
+                branch_idx].generators.get(req_idx)
+            if chosen_branch_generator is not None:
+                original_generator.set_state(
+                    chosen_branch_generator.get_state())
+        if initial_rng_state is not None and branch_rng_states:
+            # No per-request generator means the chain sampler advanced the
+            # device default RNG. Mirror that progression with the branch that
+            # actually won so later speculative steps stay aligned with the
+            # chosen standalone chain.
+            self._set_device_rng_state(
+                branch_rng_states[int(chosen_branch[0].item())])
+
+        for req_idx in range(num_reqs):
+            branch_idx = int(chosen_branch[req_idx].item())
+            branch_output = branch_outputs[branch_idx][req_idx]
+            valid_count = int(valid_count_matrix[req_idx, branch_idx].item())
+            if valid_count <= 0:
+                continue
+            accepted_draft_count = max(valid_count - 1, 0)
+            path = self.leaf_paths[branch_idx]
+            for depth_idx in range(accepted_draft_count):
+                output_token_ids[req_idx,
+                                 path[depth_idx]] = branch_output[depth_idx]
+            output_token_ids[req_idx,
+                             draft_tree_size] = branch_output[valid_count - 1]
+
+        return SamplerOutput(
+            sampled_token_ids=output_token_ids,
+            logprobs_tensors=None,
+        )
+
+    def compute_tree_target_token_ids(
+        self,
+        logits: torch.Tensor,
+        is_tree_decode: torch.Tensor,
+        num_tree_decodes: int,
+        sampling_metadata: SamplingMetadata,
+    ) -> torch.Tensor:
+        if sampling_metadata.all_greedy:
+            return logits.argmax(dim=-1)
+
+        # How many times to repeat the temperature, top-k, and top-p
+        # for each tree-decode batch.
+        num_repeats = logits.shape[0] // num_tree_decodes
+
+        assert sampling_metadata.temperature is not None
+        temperature = sampling_metadata.temperature[is_tree_decode]
+        temperature = temperature.repeat_interleave(num_repeats)
+        logits.div_(temperature.view(-1, 1))
+
+        top_k = None
+        if sampling_metadata.top_k is not None:
+            top_k = sampling_metadata.top_k[is_tree_decode]
+            top_k = top_k.repeat_interleave(num_repeats)
+            # Sampling disables top-k with 0 / -1. The Ascend custom op uses
+            # `k == vocab_size` as the no-op form, so normalize here to keep
+            # tree verification on the fast NPU path even for top-p-only runs.
+            vocab_size = logits.shape[-1]
+            top_k = torch.where(
+                top_k <= 0,
+                torch.full_like(top_k, vocab_size),
+                top_k,
+            )
+        top_p = None
+        if sampling_metadata.top_p is not None:
+            top_p = sampling_metadata.top_p[is_tree_decode]
+            top_p = top_p.repeat_interleave(num_repeats)
+
+        logits = apply_top_k_top_p(logits, top_k, top_p)
+        return logits.argmax(dim=-1)
+
+
+@triton.jit
+def _scatter_accepted_tokens_kernel(
+    draft_token_ids_ptr,
+    output_token_ids_ptr,
+    accepted_offsets_ptr,
+    tree_mask_ptr,
+    draft_tree_size,
+    placeholder_token_id: tl.constexpr,
+    block_size: tl.constexpr,
+):
+    """
+    For batches that correspond to tree decodes, accepted token ids from
+    draft_token_ids are scattered to the corresponding indices in
+    output_token_ids. All other indices are set to placeholder_token_id.
+    Whether a token from draft_token_ids is accepted or not is determined by
+    indexing into tree_mask via accepted_offsets.
+    Args:
+        draft_token_ids_ptr: [num_reqs, draft_tree_size] Draft token ids.
+        output_token_ids_ptr: [num_reqs, draft_tree_size + 1] Output buffer.
+        accepted_offsets_ptr: [num_reqs] - Indices into tree_mask rows.
+        tree_mask_ptr: [draft_tree_size + 1, draft_tree_size] - Boolean masks
+                       for paths to each node in the tree.
+        draft_tree_size: Size of draft tree.
+        placeholder_token_id: Placeholder token id for rejected tokens.
+        block_size: Block size
+    Grid: (num_reqs, ceil(draft_tree_size / BLOCK_SIZE))
+    """
+
+    req_idx = tl.program_id(0)
+    block_idx = tl.program_id(1)
+
+    # Get the accepted token index offset for this request.
+    accepted_offset = tl.load(accepted_offsets_ptr + req_idx)
+
+    # Calculate which tokens this block processes.
+    block_start = block_idx * block_size
+    token_offsets = block_start + tl.arange(0, block_size)
+    token_mask = token_offsets < draft_tree_size
+
+    # Get accepted path mask. Index as tree_mask[accepted_offset, :].
+    path_mask_base = accepted_offset * draft_tree_size
+    accepted_path_mask = tl.load(
+        tree_mask_ptr + path_mask_base + token_offsets,
+        mask=token_mask,
+        other=0,
+    ).to(tl.int1)
+
+    # Load draft tokens for this request.
+    draft_base = req_idx * draft_tree_size
+    draft_tokens = tl.load(draft_token_ids_ptr + draft_base + token_offsets,
+                           mask=token_mask,
+                           other=placeholder_token_id)
+
+    # Select draft tokens based on the accepted path mask.
+    output_tokens = tl.where(accepted_path_mask, draft_tokens,
+                             placeholder_token_id)
+
+    # Store to output at the same positions.
+    output_width = draft_tree_size + 1
+    output_base = req_idx * output_width
+    tl.store(output_token_ids_ptr + output_base + token_offsets,
+             output_tokens,
+             mask=token_mask)
