+    def _parse_tree_choices(self) -> list[tuple[int, ...]]:
+        tree_spec = getattr(self.speculative_config, "speculative_token_tree", None)
+        if tree_spec is None:
+            return tuple((0,) for _ in range(max(1, self.num_speculative_tokens)))
+        if isinstance(tree_spec, str):
+            tree_spec = tree_spec.strip()
+            if tree_spec.startswith("["):
+                parsed = ast.literal_eval(tree_spec)
+            else:
+                raw_levels = [int(x.strip()) for x in tree_spec.split(",") if x.strip()]
+                parsed = raw_levels
+        else:
+            parsed = tree_spec
+
+        # Backward compatible: old format like [2,2,1] / "2,2,1".
+        if isinstance(parsed, (list, tuple)) and len(parsed) > 0 and isinstance(parsed[0], int):
+            tree_levels = [max(1, int(x)) for x in parsed]
+            level_nodes = []
+            prev_paths = [tuple()]
+            for width in tree_levels:
+                curr_paths = []
+                for parent in prev_paths:
+                    for child_idx in range(width):
+                        curr_paths.append(parent + (child_idx,))
+                level_nodes.extend(curr_paths)
+                prev_paths = curr_paths
+            tree_choices = level_nodes
+        else:
+            tree_choices = [tuple(int(x) for x in path) for path in parsed]
+
+        tree_choices = sorted(tree_choices, key=lambda x: (len(x), x))
+        if not tree_choices:
+            tree_choices = [(0,)]
+        return tree_choices
+
+    def _build_tree_info(self, tree_choices: list[tuple[int, ...]]):
+        path_to_idx = {path: i for i, path in enumerate(tree_choices)}
+        children = [[] for _ in tree_choices]
+        parent_idx = []
+        depth = []
+        branch_idx = []
+        level_to_nodes = {}
+        for i, path in enumerate(tree_choices):
+            d = len(path)
+            depth.append(d - 1)
+            branch_idx.append(path[-1])
+            level_to_nodes.setdefault(d - 1, []).append(i)
+            if d == 1:
+                parent_idx.append(-1)
+            else:
+                p = path[:-1]
+                pi = path_to_idx[p]
+                parent_idx.append(pi)
+                children[pi].append(i)
+        max_depth = max(len(p) for p in tree_choices)
+        level_node_ids = [level_to_nodes.get(i, []) for i in range(max_depth)]
+        branch_idx_tensor = torch.tensor(
+            branch_idx, device=self.device, dtype=torch.long)
+        level_node_id_tensors = [
+            torch.tensor(node_ids, device=self.device, dtype=torch.long)
+            for node_ids in level_node_ids
+        ]
+        child_branch_tensors = []
+        for child_node_ids in children:
+            child_branch_tensors.append(
+                branch_idx_tensor.index_select(
+                    0, torch.tensor(child_node_ids, device=self.device, dtype=torch.long)
+                ) if child_node_ids else torch.empty(
+                    (0,), device=self.device, dtype=torch.long)
+            )
+        return {
+            "tree_choices": tree_choices,
+            "path_to_idx": path_to_idx,
+            "children": children,
+            "parent_idx": parent_idx,
+            "depth": depth,
+            "branch_idx": branch_idx,
+            "branch_idx_tensor": branch_idx_tensor,
+            "level_node_ids": level_node_ids,
+            "level_node_id_tensors": level_node_id_tensors,
+            "child_branch_tensors": child_branch_tensors,
+            "num_nodes": len(tree_choices),
+            "max_depth": max_depth,
+        }
+
+    def _is_linear_tree(self, tree_info: dict[str, Any]) -> bool:
+        tree_choices = tree_info["tree_choices"]
+        if len(tree_choices) != self.num_speculative_tokens:
+            return False
+        return all(path == (0,) * (idx + 1)
+                   for idx, path in enumerate(tree_choices))
+
+    def _get_primary_chain_node_ids(self, tree_info: dict[str, Any]) -> list[int]:
+        primary_node_ids = [
+            node_id
+            for node_id, path in enumerate(tree_info["tree_choices"])
+            if path and all(branch == 0 for branch in path)
+        ]
+        if primary_node_ids:
+            return primary_node_ids
+
+        children = tree_info["children"]
+        level_node_ids = tree_info["level_node_ids"]
+        if not level_node_ids or not level_node_ids[0]:
+            return []
+        node_id = level_node_ids[0][0]
+        chain = [node_id]
+        while children[node_id]:
+            node_id = children[node_id][0]
+            chain.append(node_id)
+        return chain
+
+    def should_use_chain_fallback(self, num_reqs: int) -> bool:
+        if self.tree_chain_fallback_max_reqs <= 0:
+            return False
+        tree_choices = self._parse_tree_choices()
+        tree_info = self._build_tree_info(tree_choices)
+        self._last_tree_info = tree_info
+        if self._is_linear_tree(tree_info):
+            return False
+        return num_reqs <= self.tree_chain_fallback_max_reqs
+
+    def set_chain_fallback_active(self, active: bool) -> None:
+        self.chain_fallback_active = active
+        if not active:
+            self._chain_fallback_steps = 0
+
+    def _use_tree_attn_level_path(self, level_depth: int) -> bool:
+        max_levels = self.experimental_tree_attn_levels
+        if max_levels == 0:
+            return False
+        if max_levels < 0:
+            return True
+        return level_depth <= max_levels
+
+    def _set_tree_rejection_state(self,
+                                  tree_info: dict[str, Any],
+                                  batch_size: int) -> None:
+        self.last_tree_choices = tree_info["tree_choices"]
+
+        if self._is_linear_tree(tree_info):
+            # A chain-shaped tree must be semantically identical to the normal
+            # chain speculative path, not merely share the same drafter logits.
+            #
+            # Keep the tree layout metadata for debugging / sparse-input bridge,
+            # but DO NOT expose a tree attention bias to the runner. Otherwise
+            # later stages still enter tree-specific verification, position
+            # offsetting, and tree rejection sampling, which makes a linear tree
+            # diverge from the chain branch even though drafting itself already
+            # uses `_run_merged_draft`.
+            cache_key = ("linear", tuple(tree_info["tree_choices"]), batch_size)
+            cached = self._tree_rejection_state_cache.get(cache_key)
+            if cached is None:
+                parent_list = torch.tensor(
+                    tree_info["parent_idx"], dtype=torch.int32,
+                    device=self.device).view(1, -1).repeat(batch_size, 1)
+                node_depths = torch.tensor(
+                    tree_info["depth"], dtype=torch.int32,
+                    device=self.device).view(1, -1).repeat(batch_size, 1)
+                cached = (parent_list, node_depths)
+                self._tree_rejection_state_cache[cache_key] = cached
+
+            self.last_tree_parent_list, self.last_tree_node_depths = cached
+            self.last_tree_attn_bias = None
+            self.last_tree_draft_source_offsets = None
+            self.tree_bias_list = None
+            return
+
+        cache_key = (tuple(tree_info["tree_choices"]), batch_size)
+        cached = self._tree_rejection_state_cache.get(cache_key)
+        if cached is None:
+            parent_list = torch.tensor(
+                tree_info["parent_idx"], dtype=torch.int32,
+                device=self.device).view(1, -1).repeat(batch_size, 1)
+            node_depths = torch.tensor(
+                tree_info["depth"], dtype=torch.int32,
+                device=self.device).view(1, -1).repeat(batch_size, 1)
+            attn_bias = self._prepare_tree_attn_bias_from_choices(
+                tree_info["tree_choices"])
+            path_to_idx = {path: idx for idx, path in enumerate(tree_info["tree_choices"])}
+            draft_source_offsets = []
+            for path in tree_info["tree_choices"]:
+                if len(path) == 1:
+                    draft_source_offsets.append(0)
+                else:
+                    draft_source_offsets.append(path_to_idx[path[:-1]] + 1)
+            draft_source_offsets_t = torch.tensor(
+                draft_source_offsets,
+                dtype=torch.int64,
+                device=self.device,
+            )
+            cached = (
+                parent_list,
+                node_depths,
+                attn_bias,
+                attn_bias.detach(),
+                draft_source_offsets_t,
+            )
+            self._tree_rejection_state_cache[cache_key] = cached
+
+        (self.last_tree_parent_list,
+         self.last_tree_node_depths,
+         self.last_tree_attn_bias,
+         self.tree_bias_list,
+         self.last_tree_draft_source_offsets) = cached
+
+    def _prepare_tree_attn_bias_from_choices(self, tree_choices: list[tuple[int, ...]]) -> torch.Tensor:
+        # Target verification runs over the root token plus every draft node in
+        # one packed tree decode step. The qq bias therefore has to include the
+        # synthetic root row/column, matching vLLM's TreeDrafterParams mask.
+        tree_len = len(tree_choices) + 1
+        # Ascend's unified_attention draft path is unstable with literal
+        # `-inf` entries in qq_bias. Use a large finite negative mask instead;
+        # after softmax this is still effectively zero probability.
+        tree_attn_bias = torch.full(
+            (tree_len, tree_len),
+            -1e9,
+            dtype=torch.float32,
+            device=self.device,
+        )
+        tree_attn_bias.fill_diagonal_(0)
+        tree_attn_bias[:, 0] = 0
+        path_to_pos = {path: i for i, path in enumerate(tree_choices)}
+        for row, path in enumerate(tree_choices, start=1):
+            for d in range(1, len(path)):
+                tree_attn_bias[row, path_to_pos[path[:d]] + 1] = 0
+        return tree_attn_bias
+
+    def _select_tokens_from_logits(self, logits: torch.Tensor, branch_indices: torch.Tensor) -> torch.Tensor:
+        """Select per-parent branch tokens while preserving chain continuity.
+
+        Branch 0 must be *exactly* the same token that chain drafting would pick
+        at the same parent state. Using ``topk(..., k>1)[:, 0]`` is not robust
+        enough here because tie handling for top-k can diverge from ``argmax`` on
+        some backends. So we always anchor branch 0 to ``argmax`` and only use
+        top-k to fill the extra sibling branches.
+        """
+        if branch_indices.ndim != 1:
+            branch_indices = branch_indices.reshape(-1)
+        branch_indices = branch_indices.to(device=logits.device, dtype=torch.long)
+        if branch_indices.numel() == 0:
+            return torch.empty((logits.shape[0], 0), dtype=torch.int64, device=logits.device)
+
+        max_branch = int(branch_indices.max().item())
+        vocab_size = logits.shape[-1]
+        k = min(max_branch + 1, vocab_size)
+
+        argmax_ids = logits.argmax(dim=-1, keepdim=True)
+        if k == 1:
+            return argmax_ids.to(torch.int64)
+
+        topk_ids = torch.topk(logits, k=k, dim=-1).indices
+        safe_branch_indices = branch_indices.clamp(0, k - 1)
+        selected = topk_ids.index_select(1, safe_branch_indices)
+
+        zero_mask = (branch_indices == 0)
+        if zero_mask.any():
+            selected[:, zero_mask] = argmax_ids.expand(-1, int(zero_mask.sum().item()))
+        return selected.to(torch.int64)
+
+    def _init_tree_runtime_state(self,
+                                 common_attn_metadata,
+                                 builder,
+                                 batch_size,
+                                 target_positions,
+                                 last_token_indices,
+                                 tree_info):
+        if self.uses_mrope:
+            base_positions = target_positions[:, last_token_indices].clone()
+            rope_base_positions = base_positions[0].clone()
+        else:
+            base_positions = target_positions[last_token_indices].clone()
+            rope_base_positions = base_positions.clone()
+
+        attn_metadata_builder = self.attn_metadata_builder             if self.attn_metadata_builder is not None             else self._get_attention_metadata_builder()
+        block_size = attn_metadata_builder.kv_cache_spec.block_size
+
+        return {
+            "builder": builder,
+            "tree_info": tree_info,
+            "batch_size": batch_size,
+            "base_positions": base_positions,
+            "rope_base_positions": rope_base_positions,
+            "base_seq_lens": common_attn_metadata.seq_lens[:batch_size].clone(),
+            "base_seq_lens_cpu": common_attn_metadata.seq_lens_cpu[:batch_size].clone(),
+            "base_num_computed_tokens_cpu": (
+                common_attn_metadata.num_computed_tokens_cpu[:batch_size].clone()),
+            "base_block_tables": common_attn_metadata.block_table_tensor[:batch_size].clone(),
+            "block_size": block_size,
+        }
+
+    def _clone_spec_common_attn_metadata(self,
+                                       common_attn_metadata: CommonAttentionMetadata,
+                                       batch_size: int) -> AscendCommonAttentionMetadata:
+        query_start_loc = common_attn_metadata.query_start_loc[:batch_size + 1].clone()
+        query_start_loc_cpu = common_attn_metadata.query_start_loc_cpu[:batch_size + 1].clone()
+        seq_lens = common_attn_metadata.seq_lens[:batch_size].clone()
+        seq_lens_cpu = common_attn_metadata.seq_lens_cpu[:batch_size].clone()
+        num_computed_tokens_cpu = common_attn_metadata.num_computed_tokens_cpu[:batch_size].clone()
+        block_table_tensor = common_attn_metadata.block_table_tensor[:batch_size].clone()
+        slot_mapping = common_attn_metadata.slot_mapping.clone()
+        positions = common_attn_metadata.positions.clone()
+        return AscendCommonAttentionMetadata(
+            query_start_loc=query_start_loc,
+            query_start_loc_cpu=query_start_loc_cpu,
+            seq_lens=seq_lens,
+            seq_lens_cpu=seq_lens_cpu,
+            num_computed_tokens_cpu=num_computed_tokens_cpu,
+            num_reqs=batch_size,
+            num_actual_tokens=common_attn_metadata.num_actual_tokens,
+            num_input_tokens=common_attn_metadata.num_input_tokens,
+            max_query_len=common_attn_metadata.max_query_len,
+            block_table_tensor=block_table_tensor,
+            slot_mapping=slot_mapping,
+            actual_seq_lengths_q=common_attn_metadata.actual_seq_lengths_q,
+            positions=positions,
+            attn_state=common_attn_metadata.attn_state,
+            decode_token_per_req=common_attn_metadata.decode_token_per_req,
+            max_seq_len=common_attn_metadata.max_seq_len,
+        )
+
+    def _build_grouped_root_common_attn_metadata(
+        self,
+        common_attn_metadata: CommonAttentionMetadata,
+        req_indices: list[int],
+        token_indices: torch.Tensor,
+    ) -> AscendCommonAttentionMetadata:
+        req_indices_cpu = torch.tensor(req_indices, dtype=torch.long)
+        query_start_loc_cpu = common_attn_metadata.query_start_loc_cpu[
+            :common_attn_metadata.num_reqs + 1]
+        query_lens_cpu = torch.diff(query_start_loc_cpu).index_select(
+            0, req_indices_cpu).to(torch.int32)
+        grouped_query_start_loc_cpu = torch.zeros(
+            (len(req_indices) + 1,), dtype=torch.int32)
+        grouped_query_start_loc_cpu[1:] = torch.cumsum(
+            query_lens_cpu, dim=0, dtype=torch.int32)
+        grouped_query_start_loc = grouped_query_start_loc_cpu.to(
+            device=self.device, non_blocking=False)
+
+        if common_attn_metadata.positions.ndim == 1:
+            positions = common_attn_metadata.positions.index_select(
+                0, token_indices).clone()
+        else:
+            positions = common_attn_metadata.positions.index_select(
+                1, token_indices).clone()
+
+        num_actual_tokens = int(grouped_query_start_loc_cpu[-1].item())
+        return AscendCommonAttentionMetadata(
+            query_start_loc=grouped_query_start_loc,
+            query_start_loc_cpu=grouped_query_start_loc_cpu,
+            seq_lens=common_attn_metadata.seq_lens.index_select(
+                0, req_indices_cpu.to(common_attn_metadata.seq_lens.device)).clone(),
+            seq_lens_cpu=common_attn_metadata.seq_lens_cpu.index_select(
+                0, req_indices_cpu).clone(),
+            num_computed_tokens_cpu=common_attn_metadata.num_computed_tokens_cpu.index_select(
+                0,
+                req_indices_cpu.to(common_attn_metadata.num_computed_tokens_cpu.device),
+            ).clone(),
+            num_reqs=len(req_indices),
+            num_actual_tokens=num_actual_tokens,
+            num_input_tokens=num_actual_tokens,
+            max_query_len=int(query_lens_cpu.max().item()) if len(req_indices) > 0 else 1,
+            block_table_tensor=common_attn_metadata.block_table_tensor.index_select(
+                0, req_indices_cpu.to(common_attn_metadata.block_table_tensor.device)).clone(),
+            slot_mapping=common_attn_metadata.slot_mapping.index_select(
+                0, token_indices).clone(),
+            actual_seq_lengths_q=grouped_query_start_loc_cpu[1:].tolist(),
+            positions=positions,
+            attn_state=common_attn_metadata.attn_state,
+            decode_token_per_req=common_attn_metadata.decode_token_per_req,
+            max_seq_len=common_attn_metadata.max_seq_len,
+        )
+
+    def _run_topk_root_forward_grouped(
+        self,
+        num_input_tokens: int,
+        batch_size: int,
+        last_token_indices: torch.Tensor,
+        inputs_embeds: Optional[torch.Tensor],
+        common_attn_metadata: CommonAttentionMetadata,
+        builder,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        model_input_ids = self.input_ids[:num_input_tokens]
+        model_positions = self._get_positions(num_input_tokens)
+        model_hidden_states = self.hidden_states[:num_input_tokens]
+
+        query_start_loc_cpu = common_attn_metadata.query_start_loc_cpu[:batch_size + 1]
+        query_lens = torch.diff(query_start_loc_cpu).tolist()
+        query_len_to_req_indices: dict[int, list[int]] = {}
+        for req_idx, query_len in enumerate(query_lens):
+            query_len_to_req_indices.setdefault(int(query_len), []).append(req_idx)
+
+        if len(query_len_to_req_indices) == 1:
+            model_hidden_states, model_positions = self.maybe_pad_and_reduce(
+                model_hidden_states, model_positions)
+            ret_hidden_states = self.model(
+                input_ids=model_input_ids,
+                positions=model_positions,
+                hidden_states=model_hidden_states,
+                inputs_embeds=inputs_embeds,
+            )
+            if self.method == "mtp":
+                last_hidden_states = ret_hidden_states
+                hidden_states = last_hidden_states
+            else:
+                last_hidden_states, hidden_states = ret_hidden_states
+            last_hidden_states, model_positions, hidden_states = \
+                self.maybe_all_gather_and_unpad(
+                    last_hidden_states, model_positions, hidden_states)
+
+            sample_hidden_states = last_hidden_states[last_token_indices]
+            root_hidden_states = (
+                sample_hidden_states if self.method == "mtp"
+                else hidden_states[last_token_indices])
+            root_logits = self.model.compute_logits(sample_hidden_states)
+            return root_logits, root_hidden_states
+
+        root_logits = None
+        root_hidden_states = None
+        for req_indices in query_len_to_req_indices.values():
+            token_indices_list: list[int] = []
+            for req_idx in req_indices:
+                start = int(query_start_loc_cpu[req_idx].item())
+                end = int(query_start_loc_cpu[req_idx + 1].item())
+                token_indices_list.extend(range(start, end))
+            token_indices = torch.tensor(
+                token_indices_list, device=self.device, dtype=torch.long)
+            group_common_attn_metadata = self._build_grouped_root_common_attn_metadata(
+                common_attn_metadata, req_indices, token_indices)
+            group_attn_metadata = builder.build(
+                0, group_common_attn_metadata, self.runner.get_model())
+            per_layer_attn_metadata = {
+                layer_name: group_attn_metadata
+                for layer_name in self.attn_layer_names
+            }
+
+            group_input_ids = model_input_ids.index_select(0, token_indices)
+            if model_positions.ndim == 2:
+                group_positions = model_positions.index_select(1, token_indices)
+            else:
+                group_positions = model_positions.index_select(0, token_indices)
+            group_hidden_states = model_hidden_states.index_select(0, token_indices)
+            group_inputs_embeds = (
+                inputs_embeds.index_select(0, token_indices)
+                if inputs_embeds is not None else None)
+            group_num_input_tokens = int(token_indices.numel())
+
+            with set_ascend_forward_context(
+                per_layer_attn_metadata,
+                self.vllm_config,
+                num_tokens=group_num_input_tokens,
+                num_actual_tokens=group_num_input_tokens,
+                aclgraph_runtime_mode=CUDAGraphMode.NONE,
+                is_draft_model=True,
+            ):
+                group_hidden_states, group_positions = self.maybe_pad_and_reduce(
+                    group_hidden_states, group_positions)
+                ret_hidden_states = self.model(
+                    input_ids=group_input_ids,
+                    positions=group_positions,
+                    hidden_states=group_hidden_states,
+                    inputs_embeds=group_inputs_embeds,
+                )
+                if self.method == "mtp":
+                    group_last_hidden_states = ret_hidden_states
+                    group_hidden_states_out = group_last_hidden_states
+                else:
+                    group_last_hidden_states, group_hidden_states_out = ret_hidden_states
+                group_last_hidden_states, group_positions, group_hidden_states_out = \
+                    self.maybe_all_gather_and_unpad(
+                        group_last_hidden_states, group_positions, group_hidden_states_out)
+
+            group_last_token_indices = (
+                group_common_attn_metadata.query_start_loc[1:] - 1).to(torch.long)
+            group_sample_hidden_states = group_last_hidden_states[group_last_token_indices]
+            group_root_hidden_states = (
+                group_sample_hidden_states if self.method == "mtp"
+                else group_hidden_states_out[group_last_token_indices])
+            group_root_logits = self.model.compute_logits(group_sample_hidden_states)
+
+            if root_logits is None:
+                root_logits = torch.empty(
+                    (batch_size, group_root_logits.shape[-1]),
+                    dtype=group_root_logits.dtype,
+                    device=group_root_logits.device,
+                )
+                root_hidden_states = torch.empty(
+                    (batch_size, group_root_hidden_states.shape[-1]),
+                    dtype=group_root_hidden_states.dtype,
+                    device=group_root_hidden_states.device,
+                )
+            req_indices_t = torch.tensor(
+                req_indices, device=self.device, dtype=torch.long)
+            root_logits.index_copy_(0, req_indices_t, group_root_logits)
+            root_hidden_states.index_copy_(0, req_indices_t, group_root_hidden_states)
+
+        assert root_logits is not None
+        assert root_hidden_states is not None
+        return root_logits, root_hidden_states
+
+
+    def _replay_tree_parent_logits(self,
+                                   parent_path_node_ids: list[int],
+                                   packed: torch.Tensor,
+                                   base_last_positions: torch.Tensor,
+                                   base_root_hidden_states: torch.Tensor,
+                                   base_common_attn_metadata: CommonAttentionMetadata,
+                                   base_attn_metadata,
+                                   batch_size: int) -> torch.Tensor:
+        if not parent_path_node_ids:
+            raise ValueError("parent_path_node_ids must be non-empty for replay")
+
+        positions = base_last_positions.clone()
+        current_hidden = base_root_hidden_states.clone()
+        common_attn_metadata = self._clone_spec_common_attn_metadata(
+            base_common_attn_metadata, batch_size)
+        attn_metadata = base_attn_metadata
+        forward_context = get_forward_context()
+
+        for step_idx, node_id in enumerate(parent_path_node_ids, start=1):
+            input_ids = packed[:, node_id]
+            common_attn_metadata, attn_metadata = self.attn_update_stack_num_spec_norm(
+                step_idx,
+                attn_metadata,
+                common_attn_metadata,
+                batch_size,
+                batch_size,
+                positions,
+                CUDAGraphMode.NONE,
+            )
+
+            if self.uses_mrope:
+                step_positions = common_attn_metadata.positions[:, :batch_size]
+            else:
+                step_positions = common_attn_metadata.positions[:batch_size]
+
+            self.input_ids[:batch_size] = input_ids
+            self._set_positions(batch_size, step_positions)
+            self.hidden_states[:batch_size] = current_hidden
+
+            if self.supports_mm_inputs:
+                self.inputs_embeds[:batch_size] = self.model.embed_input_ids(
+                    input_ids)
+                active_inputs_embeds = self.inputs_embeds[:batch_size]
+            else:
+                active_inputs_embeds = None
+
+            update_cos_sin(self._get_positions(batch_size))
+            model_input_ids = self.input_ids[:batch_size]
+            model_positions = self._get_positions(batch_size)
+            model_hidden_states = self.hidden_states[:batch_size]
+            model_hidden_states, model_positions = self.maybe_pad_and_reduce(
+                model_hidden_states, model_positions)
+
+            forward_context.num_tokens = batch_size
+            forward_context.num_accept_tokens = batch_size
+            forward_context.attn_metadata = {
+                layer_name: attn_metadata for layer_name in self.attn_layer_names
+            }
+            ret_hidden_states = self.model(
+                input_ids=model_input_ids,
+                positions=model_positions,
+                hidden_states=model_hidden_states,
+                inputs_embeds=active_inputs_embeds,
+            )
+            if self.method == "mtp":
+                last_hidden_states = ret_hidden_states
+                hidden_states = last_hidden_states
+            else:
+                last_hidden_states, hidden_states = ret_hidden_states
+            last_hidden_states, model_positions, hidden_states =                 self.maybe_all_gather_and_unpad(
+                    last_hidden_states, model_positions, hidden_states)
+            logits = self.model.compute_logits(last_hidden_states[:batch_size])
+            current_hidden = (last_hidden_states[:batch_size]
+                              if self.method == "mtp" else
+                              hidden_states[:batch_size])
+
+        return logits
+
+    def _run_tree_draft_token(self,
+                              draft_step: int,
+                              input_ids: torch.Tensor,
+                              current_hidden: torch.Tensor,
+                              positions: torch.Tensor,
+                              common_attn_metadata: CommonAttentionMetadata,
+                              attn_metadata,
+                              batch_size: int):
+        common_attn_metadata, attn_metadata = self.attn_update_stack_num_spec_norm(
+            draft_step,
+            attn_metadata,
+            common_attn_metadata,
+            batch_size,
+            batch_size,
+            positions,
+            CUDAGraphMode.NONE,
+        )
+
+        if self.uses_mrope:
+            step_positions = common_attn_metadata.positions[:, :batch_size]
+        else:
+            step_positions = common_attn_metadata.positions[:batch_size]
+
+        self.input_ids[:batch_size] = input_ids
+        self._set_positions(batch_size, step_positions)
+        self.hidden_states[:batch_size] = current_hidden
+
+        if self.supports_mm_inputs:
+            self.inputs_embeds[:batch_size] = self.model.embed_input_ids(
+                input_ids)
+            active_inputs_embeds = self.inputs_embeds[:batch_size]
+        else:
+            active_inputs_embeds = None
+
+        update_cos_sin(self._get_positions(batch_size))
+        model_input_ids = self.input_ids[:batch_size]
+        model_positions = self._get_positions(batch_size)
+        model_hidden_states = self.hidden_states[:batch_size]
+        model_hidden_states, model_positions = self.maybe_pad_and_reduce(
+            model_hidden_states, model_positions)
+
+        forward_context = get_forward_context()
+        forward_context.num_tokens = batch_size
+        forward_context.num_accept_tokens = batch_size
+        forward_context.attn_metadata = {
+            layer_name: attn_metadata for layer_name in self.attn_layer_names
+        }
+        ret_hidden_states = self.model(
+            input_ids=model_input_ids,
+            positions=model_positions,
+            hidden_states=model_hidden_states,
+            inputs_embeds=active_inputs_embeds,
+        )
+        if self.method == "mtp":
+            last_hidden_states = ret_hidden_states
+            hidden_states = last_hidden_states
+        else:
+            last_hidden_states, hidden_states = ret_hidden_states
+        last_hidden_states, model_positions, hidden_states = \
+            self.maybe_all_gather_and_unpad(
+                last_hidden_states, model_positions, hidden_states)
+        logits = self.model.compute_logits(last_hidden_states[:batch_size])
+        next_hidden = (last_hidden_states[:batch_size]
+                       if self.method == "mtp" else hidden_states[:batch_size])
+
+        return (
+            logits,
+            next_hidden,
+            positions,
+            common_attn_metadata,
+            attn_metadata,
+        )
+
+    def _run_tree_level_batched(self,
+                                input_token_ids: torch.Tensor,
+                                parent_hidden_states: torch.Tensor,
+                                parent_last_positions: torch.Tensor,
+                                parent_seq_lens: torch.Tensor,
+                                parent_seq_lens_cpu: torch.Tensor,
+                                parent_num_computed_tokens_cpu: torch.Tensor,
+                                parent_block_tables: torch.Tensor,
+                                token_depth: int,
+    ) -> tuple[
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+    ]:
+        """Run all parent nodes of the same depth in one batched forward.
+
+        Shapes:
+            input_token_ids: [num_nodes_at_depth, batch_size]
+            parent_hidden_states: [num_nodes_at_depth, batch_size, hidden]
+            parent_last_positions: [num_nodes_at_depth, batch_size] or
+                [num_nodes_at_depth, 3, batch_size] for M-RoPE.
+        """
+        num_nodes_at_depth, batch_size = input_token_ids.shape
+        flat_batch = num_nodes_at_depth * batch_size
+        if flat_batch == 0:
+            raise ValueError("flat_batch must be positive")
+
+        flat_input_ids = input_token_ids.contiguous().reshape(flat_batch)
+        flat_hidden_states = parent_hidden_states.contiguous().reshape(
+            flat_batch, parent_hidden_states.shape[-1])
+
+        if self.uses_mrope:
+            flat_last_positions = parent_last_positions.permute(1, 0, 2).contiguous().reshape(
+                parent_last_positions.shape[1], flat_batch)
+            next_positions = flat_last_positions + 1
+            exceeds_max_model_len = (
+                next_positions[0] >= self.vllm_config.model_config.max_model_len)
+            clamped_positions = torch.where(
+                exceeds_max_model_len.unsqueeze(0),
+                torch.zeros_like(next_positions),
+                next_positions,
+            )
+        else:
+            flat_last_positions = parent_last_positions.contiguous().reshape(flat_batch)
+            next_positions = flat_last_positions + 1
+            exceeds_max_model_len = (
+                next_positions >= self.vllm_config.model_config.max_model_len)
+            clamped_positions = torch.where(
+                exceeds_max_model_len,
+                torch.zeros_like(next_positions),
+                next_positions,
+            )
+
+        flat_seq_lens = parent_seq_lens.contiguous().reshape(flat_batch).clone()
+        flat_seq_lens += 1
+        flat_seq_lens.masked_fill_(exceeds_max_model_len, 1)
+
+        flat_seq_lens_cpu = (
+            parent_seq_lens_cpu.contiguous().reshape(flat_batch).clone())
+        flat_seq_lens_cpu += 1
+        exceeds_seq_cpu = flat_seq_lens_cpu >= self.max_model_len
+        flat_seq_lens_cpu.masked_fill_(exceeds_seq_cpu, 1)
+
+        flat_num_computed_tokens_cpu = (
+            parent_num_computed_tokens_cpu.contiguous().reshape(flat_batch).clone())
+        flat_num_computed_tokens_cpu += 1
+
+        flat_block_tables = parent_block_tables.contiguous().reshape(
+            flat_batch, parent_block_tables.shape[-1]).clone()
+
+        slot_group_idx = min(token_depth, self.num_speculative_tokens - 1)
+        query_start_loc = self.arange[:flat_batch + 1]
+        query_start_loc_cpu = torch.from_numpy(
+            self.token_arange_np[:flat_batch + 1]).clone()
+
+        if self.attn_metadata_builder is None:
+            attn_metadata_builder = self._get_attention_metadata_builder()
+        else:
+            attn_metadata_builder = self.attn_metadata_builder
+        block_size = attn_metadata_builder.kv_cache_spec.block_size
+
+        if self.uses_mrope:
+            block_numbers = clamped_positions[0] // block_size
+        else:
+            block_numbers = clamped_positions // block_size
+        block_ids = flat_block_tables.gather(
+            dim=1, index=block_numbers.view(-1, 1)).view(-1)
+        if self.uses_mrope:
+            slot_mapping = block_ids * block_size + clamped_positions[0] % block_size
+        else:
+            slot_mapping = block_ids * block_size + clamped_positions % block_size
+        slot_mapping.masked_fill_(exceeds_max_model_len, PADDING_SLOT_ID)
+
+        self.slot_mapping_group[slot_group_idx][:flat_batch].copy_(
+            slot_mapping.to(torch.int32))
+        self.slot_mapping_group[slot_group_idx][flat_batch:].fill_(PADDING_SLOT_ID)
+
+        common_attn_metadata = AscendCommonAttentionMetadata(
+            query_start_loc=query_start_loc,
+            query_start_loc_cpu=query_start_loc_cpu,
+            seq_lens=flat_seq_lens,
+            seq_lens_cpu=flat_seq_lens_cpu,
+            num_computed_tokens_cpu=flat_num_computed_tokens_cpu,
+            num_reqs=flat_batch,
+            num_actual_tokens=flat_batch,
+            num_input_tokens=flat_batch,
+            max_query_len=1,
+            block_table_tensor=flat_block_tables,
+            slot_mapping=self.slot_mapping_group[slot_group_idx][:flat_batch],
+            actual_seq_lengths_q=query_start_loc_cpu[1:].tolist(),
+            positions=clamped_positions.clone(),
+            attn_state=AscendAttentionState.ChunkedPrefill,
+            decode_token_per_req=1,
+            max_seq_len=0,
+        )
+        if self.experimental_tree_attn_dryrun:
+            tree_input_ids_view = input_token_ids.transpose(0, 1).contiguous()
+
+        attn_metadata = attn_metadata_builder.build_for_drafting(  # type: ignore
+            common_attn_metadata=common_attn_metadata,
+            draft_index=slot_group_idx,
+        )
+
+        self.input_ids[:flat_batch] = flat_input_ids
+        self._set_positions(flat_batch, clamped_positions)
+        self.hidden_states[:flat_batch] = flat_hidden_states
+
+        if self.supports_mm_inputs:
+            self.inputs_embeds[:flat_batch] = self.model.embed_input_ids(
+                flat_input_ids)
+            active_inputs_embeds = self.inputs_embeds[:flat_batch]
+        else:
+            active_inputs_embeds = None
+
+        update_cos_sin(self._get_positions(flat_batch))
+        model_input_ids = self.input_ids[:flat_batch]
+        model_positions = self._get_positions(flat_batch)
+        model_hidden_states = self.hidden_states[:flat_batch]
+        model_hidden_states, model_positions = self.maybe_pad_and_reduce(
+            model_hidden_states, model_positions)
+
+        forward_context = get_forward_context()
+        forward_context.num_tokens = flat_batch
+        forward_context.num_accept_tokens = flat_batch
+        forward_context.attn_metadata = {
+            layer_name: attn_metadata for layer_name in self.attn_layer_names
+        }
+
+        ret_hidden_states = self.model(
+            input_ids=model_input_ids,
+            positions=model_positions,
+            hidden_states=model_hidden_states,
+            inputs_embeds=active_inputs_embeds,
+        )
+        if self.method == "mtp":
+            last_hidden_states = ret_hidden_states
+            hidden_states = last_hidden_states
+        else:
+            last_hidden_states, hidden_states = ret_hidden_states
+
+        last_hidden_states, model_positions, hidden_states = self.maybe_all_gather_and_unpad(
+                last_hidden_states, model_positions, hidden_states)
+
+        logits = self.model.compute_logits(last_hidden_states[:flat_batch])
+        next_hidden_states = (
+            last_hidden_states[:flat_batch]
+            if self.method == "mtp" else hidden_states[:flat_batch])
+
+        logits = logits.reshape(num_nodes_at_depth, batch_size, -1).contiguous()
+        next_hidden_states = next_hidden_states.reshape(
+            num_nodes_at_depth, batch_size, -1).contiguous()
+
+        if self.uses_mrope:
+            next_last_positions = clamped_positions.reshape(
+                clamped_positions.shape[0], num_nodes_at_depth, batch_size,
+            ).permute(1, 0, 2).contiguous()
+        else:
+            next_last_positions = clamped_positions.reshape(
+                num_nodes_at_depth, batch_size).contiguous()
+
+        next_seq_lens = flat_seq_lens.reshape(
+            num_nodes_at_depth, batch_size).contiguous()
+        next_seq_lens_cpu = flat_seq_lens_cpu.reshape(
+            num_nodes_at_depth, batch_size).contiguous()
+        next_num_computed_tokens_cpu = flat_num_computed_tokens_cpu.reshape(
+            num_nodes_at_depth, batch_size).contiguous()
+        next_block_tables = flat_block_tables.reshape(
+            num_nodes_at_depth, batch_size, -1).contiguous()
+
+        return (
+            logits,
+            next_hidden_states,
+            next_last_positions,
+            next_seq_lens,
+            next_seq_lens_cpu,
+            next_num_computed_tokens_cpu,
+            next_block_tables,
+        )
+
+    def _build_tree_level_with_bias_metadata(
+        self,
+        batch_size: int,
+        level_depth: int,
+        level_node_ids_cur: list[int],
+        current_level_tokens_t: torch.Tensor,
+        current_level_hidden_states: torch.Tensor,
+        base_last_positions: torch.Tensor,
+        base_seq_lens: torch.Tensor,
+        base_seq_lens_cpu: torch.Tensor,
+        base_num_computed_tokens_cpu: torch.Tensor,
+        base_block_tables: torch.Tensor,
+        tree_input_ids_chunks: list[torch.Tensor],
+        tree_hidden_state_chunks: list[torch.Tensor],
+        tree_position_chunks: list[torch.Tensor],
+    ) -> tuple[
+        list[torch.Tensor],
+        list[torch.Tensor],
+        list[torch.Tensor],
+        AscendCommonAttentionMetadata,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        int,
+    ]:
+        level_num_nodes = len(level_node_ids_cur)
+        level_tokens = current_level_tokens_t.transpose(0, 1).contiguous()
+        level_hidden_states = current_level_hidden_states.transpose(0, 1).contiguous()
+        if self.uses_mrope:
+            level_positions = (
+                base_last_positions.unsqueeze(-1) + level_depth
+            ).expand(-1, -1, level_num_nodes).clone()
+        else:
+            level_positions = (
+                base_last_positions.unsqueeze(-1) + level_depth
+            ).expand(-1, level_num_nodes).clone()
+
+        tree_input_ids_chunks.append(level_tokens)
+        tree_hidden_state_chunks.append(level_hidden_states)
+        tree_position_chunks.append(level_positions)
+
+        tree_input_ids = torch.cat(tree_input_ids_chunks, dim=1).contiguous()
+        tree_hidden_states = torch.cat(tree_hidden_state_chunks, dim=1).contiguous()
+        cumulative_query_len = int(tree_input_ids.shape[1])
+
+        attn_metadata_builder = self.runner.attn_groups[0][0].get_metadata_builder()
+        block_size = attn_metadata_builder.kv_cache_spec.block_size
+        # Keep RoPE/query positions equal to the true tree depth so branch-0
+        # stays aligned with standalone chain decoding, but use a synthetic
+        # packed KV layout for slot_mapping/seq_lens. Sibling nodes at the same
+        # tree depth share the same logical position and would otherwise write
+        # the same KV slot when packed into one request, which crashes the
+        # TreeAttention backend on Ascend.
+        storage_offsets = torch.arange(
+            1,
+            cumulative_query_len + 1,
+            device=self.device,
+            dtype=base_seq_lens.dtype,
+        )
+        packed_storage_positions = (
+            base_seq_lens.unsqueeze(1) + storage_offsets.unsqueeze(0) - 1
+        )
+        if self.uses_mrope:
+            tree_positions = torch.cat(tree_position_chunks, dim=2).contiguous()
+            flat_positions = tree_positions.permute(0, 2, 1).reshape(
+                tree_positions.shape[0], -1)
+            storage_block_numbers = packed_storage_positions // block_size
+        else:
+            tree_positions = torch.cat(tree_position_chunks, dim=1).contiguous()
+            flat_positions = tree_positions.reshape(-1)
+            storage_block_numbers = packed_storage_positions
+
+        if self.uses_mrope:
+            block_numbers = storage_block_numbers
+        else:
+            block_numbers = storage_block_numbers // block_size
+
+        block_ids = base_block_tables.gather(dim=1, index=block_numbers).to(
+            torch.int64)
+        slot_mapping = (
+            block_ids.reshape(-1) * block_size
+            + packed_storage_positions.reshape(-1).to(torch.int64) % block_size
+        )
+
+        query_start_loc_cpu = torch.arange(
+            0,
+            (batch_size + 1) * cumulative_query_len,
+            cumulative_query_len,
+            dtype=torch.int32,
+        )
+        query_start_loc = query_start_loc_cpu.to(
+            device=self.device, non_blocking=False)
+        seq_lens = (base_seq_lens + cumulative_query_len).clone()
+        seq_lens_cpu = (base_seq_lens_cpu + cumulative_query_len).clone()
+        num_computed_tokens_cpu = (
+            base_num_computed_tokens_cpu + cumulative_query_len).clone()
+
+        common_attn_metadata = AscendCommonAttentionMetadata(
+            query_start_loc=query_start_loc,
+            query_start_loc_cpu=query_start_loc_cpu,
+            seq_lens=seq_lens,
+            seq_lens_cpu=seq_lens_cpu,
+            num_computed_tokens_cpu=num_computed_tokens_cpu,
+            num_reqs=batch_size,
+            num_actual_tokens=batch_size * cumulative_query_len,
+            num_input_tokens=batch_size * cumulative_query_len,
+            max_query_len=cumulative_query_len,
+            block_table_tensor=base_block_tables,
+            slot_mapping=slot_mapping.to(torch.int32),
+            actual_seq_lengths_q=query_start_loc_cpu[1:].tolist(),
+            positions=flat_positions.clone(),
+            attn_state=AscendAttentionState.SpecDecoding,
+            decode_token_per_req=cumulative_query_len,
+            max_seq_len=0,
+        )
+        tree_attn_bias = self.last_tree_attn_bias[
+            1:1 + cumulative_query_len,
+            1:1 + cumulative_query_len,
+        ].contiguous()
+        return (
+            tree_input_ids_chunks,
+            tree_hidden_state_chunks,
+            tree_position_chunks,
+            common_attn_metadata,
+            tree_attn_bias,
+            tree_input_ids,
+            tree_hidden_states,
+            cumulative_query_len,
+        )
+
+    def _run_tree_level_with_bias(
+        self,
+        batch_size: int,
+        level_depth: int,
+        level_node_ids_cur: list[int],
+        current_level_tokens_t: torch.Tensor,
+        current_level_hidden_states: torch.Tensor,
+        base_last_positions: torch.Tensor,
+        base_seq_lens: torch.Tensor,
+        base_seq_lens_cpu: torch.Tensor,
+        base_num_computed_tokens_cpu: torch.Tensor,
+        base_block_tables: torch.Tensor,
+        tree_input_ids_chunks: list[torch.Tensor],
+        tree_hidden_state_chunks: list[torch.Tensor],
+        tree_position_chunks: list[torch.Tensor],
+    ) -> tuple[
+        list[torch.Tensor],
+        list[torch.Tensor],
+        list[torch.Tensor],
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+        torch.Tensor,
+    ]:
+        level_num_nodes = len(level_node_ids_cur)
+        if level_num_nodes <= 0:
+            raise ValueError("level_node_ids_cur must be non-empty")
+
+        (tree_input_ids_chunks,
+         tree_hidden_state_chunks,
+         tree_position_chunks,
+         common_attn_metadata,
+         tree_attn_bias,
+         tree_input_ids,
+         tree_hidden_states,
+         cumulative_query_len) = self._build_tree_level_with_bias_metadata(
+            batch_size=batch_size,
+            level_depth=level_depth,
+            level_node_ids_cur=level_node_ids_cur,
+            current_level_tokens_t=current_level_tokens_t,
+            current_level_hidden_states=current_level_hidden_states,
+            base_last_positions=base_last_positions,
+            base_seq_lens=base_seq_lens,
+            base_seq_lens_cpu=base_seq_lens_cpu,
+            base_num_computed_tokens_cpu=base_num_computed_tokens_cpu,
+            base_block_tables=base_block_tables,
+            tree_input_ids_chunks=tree_input_ids_chunks,
+            tree_hidden_state_chunks=tree_hidden_state_chunks,
+            tree_position_chunks=tree_position_chunks,
+        )
+        attn_metadata_builder = self.runner.attn_groups[0][0].get_metadata_builder()
+        attn_metadata = attn_metadata_builder.build(
+            0,
+            common_attn_metadata,
+            tree_attn_bias=tree_attn_bias,
+        )
+        per_layer_attn_metadata = {
+            layer_name: attn_metadata for layer_name in self.attn_layer_names
+        }
+
+        flat_input_ids = tree_input_ids.reshape(-1)
+        flat_hidden_states = tree_hidden_states.reshape(
+            batch_size * cumulative_query_len, -1)
+        self.input_ids[:batch_size * cumulative_query_len] = flat_input_ids
+        self._set_positions(batch_size * cumulative_query_len,
+                            common_attn_metadata.positions)
+        self.hidden_states[:batch_size * cumulative_query_len] = flat_hidden_states
+
+        if self.supports_mm_inputs:
+            self.inputs_embeds[:batch_size * cumulative_query_len] = (
+                self.model.embed_input_ids(flat_input_ids))
+            active_inputs_embeds = self.inputs_embeds[
+                :batch_size * cumulative_query_len]
+        else:
+            active_inputs_embeds = None
+
+        update_cos_sin(self._get_positions(batch_size * cumulative_query_len))
+        model_input_ids = self.input_ids[:batch_size * cumulative_query_len]
+        model_positions = self._get_positions(batch_size * cumulative_query_len)
+        model_hidden_states = self.hidden_states[:batch_size * cumulative_query_len]
+        model_hidden_states, model_positions = self.maybe_pad_and_reduce(
+            model_hidden_states, model_positions)
+
+        with set_ascend_forward_context(
+            per_layer_attn_metadata,
+            self.vllm_config,
+            num_tokens=batch_size * cumulative_query_len,
+            num_actual_tokens=batch_size * cumulative_query_len,
+            aclgraph_runtime_mode=CUDAGraphMode.NONE,
+            is_draft_model=True,
+        ):
+            ret_hidden_states = self.model(
+                input_ids=model_input_ids,
+                positions=model_positions,
+                hidden_states=model_hidden_states,
+                inputs_embeds=active_inputs_embeds,
+            )
+            if self.method == "mtp":
+                last_hidden_states = ret_hidden_states
+                hidden_states = last_hidden_states
+            else:
+                last_hidden_states, hidden_states = ret_hidden_states
+            last_hidden_states, model_positions, hidden_states = \
+                self.maybe_all_gather_and_unpad(
+                    last_hidden_states, model_positions, hidden_states)
+
+        level_last_hidden_states = last_hidden_states.view(
+            batch_size, cumulative_query_len, -1)[:, -level_num_nodes:]
+        level_hidden_states_out = hidden_states.view(
+            batch_size, cumulative_query_len, -1)[:, -level_num_nodes:]
+        level_logits = self.model.compute_logits(
+            level_last_hidden_states.reshape(batch_size * level_num_nodes, -1)
+        ).view(batch_size, level_num_nodes, -1).transpose(0, 1).contiguous()
+
+        if self.uses_mrope:
+            flat_positions = common_attn_metadata.positions.view(
+                common_attn_metadata.positions.shape[0],
+                batch_size,
+                cumulative_query_len,
+            )
+            level_last_positions = flat_positions[
+                :, :, -level_num_nodes:
+            ].permute(2, 0, 1).contiguous()
+        else:
+            flat_positions = common_attn_metadata.positions.view(
+                batch_size, cumulative_query_len)
+            level_last_positions = flat_positions[
+                :, -level_num_nodes:
+            ].transpose(0, 1).contiguous()
+        level_parent_hidden_states = level_hidden_states_out.transpose(0, 1).contiguous()
+        # If a later level falls back to the legacy batched path, it must see
+        # the true per-branch prefix length (base + current depth), not the
+        # cumulative packed-query length used by the tree-attention forward.
+        level_parent_seq_lens = (
+            base_seq_lens + level_depth
+        ).unsqueeze(0).expand(level_num_nodes, -1).contiguous()
+        level_parent_seq_lens_cpu = (
+            base_seq_lens_cpu + level_depth
+        ).unsqueeze(0).expand(level_num_nodes, -1).contiguous()
+        level_parent_num_computed_tokens_cpu = (
+            base_num_computed_tokens_cpu + level_depth
+        ).unsqueeze(0).expand(level_num_nodes, -1).contiguous()
+        level_parent_block_tables = base_block_tables.unsqueeze(0).expand(
+            level_num_nodes, -1, -1).contiguous()
+
+        return (
+            tree_input_ids_chunks,
+            tree_hidden_state_chunks,
+            tree_position_chunks,
+            level_logits,
+            level_parent_hidden_states,
+            level_last_positions,
+            level_parent_seq_lens,
+            level_parent_seq_lens_cpu,
+            level_parent_num_computed_tokens_cpu,
+            level_parent_block_tables,
+        )
+
+    def _collect_tree_level_token_mismatches(
+        self,
+        tree_info: dict[str, Any],
+        level_node_ids_cur: list[int],
+        level_logits: torch.Tensor,
+        compare_level_logits: torch.Tensor,
+    ) -> list[dict[str, Any]]:
+        if level_logits.shape != compare_level_logits.shape:
+            return [{
+                "reason": "level_logits_shape_mismatch",
+                "optimized_shape": list(level_logits.shape),
+                "legacy_shape": list(compare_level_logits.shape),
+            }]
+
+        mismatches: list[dict[str, Any]] = []
+        child_branch_tensors = tree_info["child_branch_tensors"]
+        children = tree_info["children"]
+        tree_choices = tree_info["tree_choices"]
+        for parent_local_idx, parent_node_id in enumerate(level_node_ids_cur):
+            child_node_ids = children[parent_node_id]
+            if not child_node_ids:
+                continue
+            child_branches = child_branch_tensors[parent_node_id]
+            optimized_tokens = self._select_tokens_from_logits(
+                level_logits[parent_local_idx], child_branches)
+            legacy_tokens = self._select_tokens_from_logits(
+                compare_level_logits[parent_local_idx], child_branches)
+            mismatch_coords = torch.nonzero(
+                optimized_tokens.ne(legacy_tokens), as_tuple=False)
+            if mismatch_coords.numel() == 0:
+                continue
+            for mismatch_coord in mismatch_coords:
+                req_idx = int(mismatch_coord[0].item())
+                child_local_idx = int(mismatch_coord[1].item())
+                child_node_id = child_node_ids[child_local_idx]
+                mismatches.append({
+                    "req_idx": req_idx,
+                    "parent_node_id": parent_node_id,
+                    "parent_path": tree_choices[parent_node_id],
+                    "child_node_id": child_node_id,
+                    "child_path": tree_choices[child_node_id],
+                    "optimized_token": int(
+                        optimized_tokens[req_idx, child_local_idx].item()),
+                    "legacy_token": int(
+                        legacy_tokens[req_idx, child_local_idx].item()),
+                })
+                if len(mismatches) >= 4:
+                    return mismatches
+        return mismatches
+
+
+
+    def _run_linear_tree_draft(self,
+                               num_input_tokens,
+                               batch_size,
+                               last_token_indices,
+                               target_positions,
+                               inputs_embeds,
+                               multi_steps_attn_metadata,
+    ) -> torch.Tensor:
+        tree_info = getattr(self, "_last_tree_info", None)
+        if tree_info is None:
+            tree_choices = self._parse_tree_choices()
+            tree_info = self._build_tree_info(tree_choices)
+            self._last_tree_info = tree_info
+
+        self._set_tree_rejection_state(tree_info, batch_size)
+        draft_token_ids = self._runnable(
+            num_input_tokens=num_input_tokens,
+            batch_size=batch_size,
+            last_token_indices=last_token_indices,
+            target_positions=target_positions,
+            inputs_embeds=inputs_embeds,
+            multi_steps_attn_metadata=multi_steps_attn_metadata,
+        )
+        return draft_token_ids
+
+    def _run_chain_fallback_draft(self,
+                                  num_input_tokens,
+                                  batch_size,
+                                  last_token_indices,
+                                  target_positions,
+                                  inputs_embeds,
+                                  multi_steps_attn_metadata,
+    ) -> torch.Tensor:
+        tree_info = getattr(self, "_last_tree_info", None)
+        if tree_info is None:
+            tree_choices = self._parse_tree_choices()
+            tree_info = self._build_tree_info(tree_choices)
+            self._last_tree_info = tree_info
+
+        primary_node_ids = self._get_primary_chain_node_ids(tree_info)
+        chain_depth = len(primary_node_ids)
+        if chain_depth <= 0:
+            return torch.empty((batch_size, 0), dtype=torch.int64, device=self.device)
+
+        orig_num_speculative_tokens = self.num_speculative_tokens
+        try:
+            self.num_speculative_tokens = chain_depth
+            draft_token_ids = self._runnable(
+                num_input_tokens=num_input_tokens,
+                batch_size=batch_size,
+                last_token_indices=last_token_indices,
+                target_positions=target_positions,
+                inputs_embeds=inputs_embeds,
+                multi_steps_attn_metadata=multi_steps_attn_metadata[:chain_depth],
+            )
+        finally:
+            self.num_speculative_tokens = orig_num_speculative_tokens
+
+        self.last_tree_choices = [tree_info["tree_choices"][i] for i in primary_node_ids]
+        self.last_tree_attn_bias = None
+        self.last_tree_draft_source_offsets = None
+        self.tree_bias_list = None
+        return draft_token_ids.tolist()
+
+
+
+    def _run_topk_path_draft(self,
+                             num_input_tokens,
+                             batch_size,
+                             last_token_indices,
+                             target_positions,
+                             inputs_embeds,
+                             multi_steps_attn_metadata,
+    ) -> torch.Tensor:
+        tree_info = getattr(self, "_last_tree_info", None)
+        if tree_info is None:
+            tree_choices = self._parse_tree_choices()
+            tree_info = self._build_tree_info(tree_choices)
+            self._last_tree_info = tree_info
+
+        root_logits, root_hidden_states = self._run_topk_root_forward_grouped(
+            num_input_tokens=num_input_tokens,
+            batch_size=batch_size,
+            last_token_indices=last_token_indices,
+            inputs_embeds=inputs_embeds,
+            common_attn_metadata=self._last_common_attn_metadata,
+            builder=self.runner.attn_groups[0][0].get_metadata_builder(),
+        )
+
+        num_nodes = tree_info["num_nodes"]
+        packed = torch.full((batch_size, num_nodes),
+                            -1,
+                            dtype=torch.int64,
+                            device=self.device)
+        self._set_tree_rejection_state(tree_info, batch_size)
+
+        level_node_ids = tree_info["level_node_ids"]
+        branch_idx_tensor = tree_info["branch_idx_tensor"]
+        children = tree_info["children"]
+
+        root_node_ids = level_node_ids[0]
+        root_branches = branch_idx_tensor.index_select(
+            0, tree_info["level_node_id_tensors"][0])
+        current_level_tokens = self._select_tokens_from_logits(
+            root_logits, root_branches)
+        for local_idx, node_idx in enumerate(root_node_ids):
+            packed[:, node_idx] = current_level_tokens[:, local_idx]
+
+        if len(level_node_ids) > 1:
+            if self.uses_mrope:
+                base_last_positions = target_positions[:, last_token_indices].clone()
+            else:
+                base_last_positions = target_positions[last_token_indices].clone()
+            base_seq_lens = self._last_common_attn_metadata.seq_lens[:batch_size]
+            base_seq_lens_cpu = self._last_common_attn_metadata.seq_lens_cpu[:batch_size]
+            base_num_computed_tokens_cpu = (
+                self._last_common_attn_metadata.num_computed_tokens_cpu[:batch_size]
+            )
+            base_block_tables = self._last_common_attn_metadata.block_table_tensor[:batch_size]
+
+            current_level_node_ids = root_node_ids
+            current_level_tokens_t = current_level_tokens.transpose(0, 1).contiguous()
+            current_parent_hidden_states = root_hidden_states.unsqueeze(0).expand(
+                len(root_node_ids), -1, -1).contiguous()
+            if self.uses_mrope:
+                current_parent_last_positions = base_last_positions.unsqueeze(0).expand(
+                    len(root_node_ids), -1, -1).contiguous()
+            else:
+                current_parent_last_positions = base_last_positions.unsqueeze(0).expand(
+                    len(root_node_ids), -1).contiguous()
+            current_parent_seq_lens = base_seq_lens.unsqueeze(0).expand(
+                len(root_node_ids), -1).contiguous()
+            current_parent_seq_lens_cpu = base_seq_lens_cpu.unsqueeze(0).expand(
+                len(root_node_ids), -1).contiguous()
+            current_parent_num_computed_tokens_cpu = (
+                base_num_computed_tokens_cpu.unsqueeze(0).expand(
+                    len(root_node_ids), -1).contiguous())
+            current_parent_block_tables = base_block_tables.unsqueeze(0).expand(
+                len(root_node_ids), -1, -1).contiguous()
+            tree_input_ids_chunks: list[torch.Tensor] = []
+            tree_hidden_state_chunks: list[torch.Tensor] = []
+            tree_position_chunks: list[torch.Tensor] = []
+
+            for level_depth, level_node_ids_cur in enumerate(level_node_ids[:-1], start=1):
+                if self._use_tree_attn_level_path(level_depth):
+                    compare_level_logits = None
+                    compare_level_next_last_positions = None
+                    compare_level_next_seq_lens = None
+                    compare_level_next_seq_lens_cpu = None
+                    compare_level_next_num_computed_tokens_cpu = None
+                    if self.experimental_tree_attn_dryrun:
+                        (
+                            compare_level_logits,
+                            _compare_level_next_hidden_states,
+                            compare_level_next_last_positions,
+                            compare_level_next_seq_lens,
